#!/bin/sh
# Start the RetroBoot checkerboard splash as early as possible: before udev
# (no PREREQ), so it already watches kernel uevents when the KMS driver
# binds. It survives switch_root ('@' argv[0])
# and hands the display to rb-presenter without a modeset.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

for arg in $(cat /proc/cmdline); do
    case "$arg" in
    retroboot.splash=0) exit 0 ;;
    esac
done

if [ -x /usr/lib/retroboot/bin/rb-splash ]; then
    /usr/lib/retroboot/bin/rb-splash --splash </dev/null >/dev/null 2>&1 &
fi
exit 0
