{
  "id": "wifi-password",
  "kind": "window",
  "title": "Wi-Fi Password",
  "width": 420,
  "items": [
    {"type": "columns", "items": [
      {"type": "icon", "icon": "wifi", "size": 32, "width": 32},
      {"type": "stack", "items": [
        {"type": "text", "style": "emphasis", "text": "The network “HomeNet” requires a password."},
        {"type": "text", "style": "small", "text": "Mac OS asked to join this network. The password is stored by RetroBoot, not by Mac OS."}
      ]}
    ]},
    {"type": "field", "id": "psk", "label": "Password:", "secure": true, "value": "", "placeholder": "8 to 63 characters", "max_length": 63},
    {"type": "checkbox", "id": "show", "label": "Show password", "value": false, "reveals": "psk"},
    {"type": "checkbox", "id": "remember", "label": "Remember this network", "value": true},
    {"type": "buttons", "items": [
      {"id": "cancel", "label": "Cancel"},
      {"id": "join", "label": "Join", "default": true}
    ]}
  ]
}
