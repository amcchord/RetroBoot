# RetroBoot Small 10 - the small regular font for secondary text, captions,
# detail text in list rows and certificate fingerprints. Original pixel art
# drawn for RetroBoot in the spirit of the classic Mac small application font:
# 1-pixel strokes, cap height 7, x-height 5, ascenders 8, descenders 2.
# MIT License (../LICENSE-fonts.txt).
font RetroBoot-Small-10
family RetroBoot Small
weight Medium
cname small10
pixel_size 10
ascent 10
descent 2
cap_height 7
x_height 5
spacing 1
accent_gap 1

