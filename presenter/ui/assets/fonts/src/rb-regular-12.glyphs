# RetroBoot Regular 12 - the regular-weight application font for body text,
# dialog paragraphs and list rows. Original pixel art drawn for RetroBoot in
# the spirit of the classic Mac application font: 1-pixel strokes, cap height
# 9, x-height 7, ascenders 10, descenders 3. MIT License (../LICENSE-fonts.txt).
font RetroBoot-Regular-12
family RetroBoot Regular
weight Medium
cname regular12
pixel_size 12
ascent 12
descent 4
cap_height 9
x_height 7
spacing 1
accent_gap 1

