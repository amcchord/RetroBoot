# RetroBoot System 12 - the bold "system font" for window titles, buttons,
# labels and emphasized text. Original pixel art drawn for RetroBoot in the
# spirit of the classic Mac system font: 2-pixel vertical stems, 1-pixel
# horizontals, cap height 9, x-height 7. MIT License (../LICENSE-fonts.txt).
font RetroBoot-System-12
family RetroBoot System
weight Bold
cname system12
pixel_size 12
ascent 12
descent 4
cap_height 9
x_height 7
spacing 1
accent_gap 1

