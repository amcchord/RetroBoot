#!/bin/sh
# Mount the RetroBoot data partition (RBDATA, XFS) on the new root before
# switch_root, so systemd finds /var/lib/retroboot already mounted instead of
# waiting about 1.4 s (VM; longer on the laptops) for udev to announce the device
# again, which held up local-fs.target and with it hostd
# (image/reports/hostboot-2026-10-12.md). Same device and options as /etc/fstab;
# the xfs module is already loading (init-top/retroboot-preload). Anything
# unusual (no partition, no mount point, a mount error) leaves it to systemd's
# fstab mount as before, which reports a missing data partition through hostd.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

case " $(cat /proc/cmdline) " in
*" boot=retroboot-live "*) exit 0 ;;   # never the installer's (or a target disk's) data
esac
dev=/dev/disk/by-partlabel/RBDATA
target="${rootmnt:-/root}/var/lib/retroboot"
if [ ! -b "$dev" ]; then
    # A Raspberry Pi card with RetroBoot beside the installer (MBR, no partition names):
    # the root's fstab names the data partition by PARTUUID (ARCHITECTURE 8.2).
    spec=$(awk '$2 == "/var/lib/retroboot" && $1 !~ /^#/ { print $1; exit }' "${rootmnt:-/root}/etc/fstab" 2>/dev/null)
    case "$spec" in
    PARTUUID=*) dev="/dev/disk/by-partuuid/${spec#PARTUUID=}" ;;
    esac
fi
[ -b "$dev" ] && [ -d "$target" ] || exit 0
modprobe -q xfs 2>/dev/null || true      # waits for the preload if it is still running
mount -t xfs -o noatime "$dev" "$target" 2>/dev/null || true
exit 0
