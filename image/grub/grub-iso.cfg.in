# RetroBoot installer ISO GRUB configuration (generated by image/scripts/make-iso.sh).
# Same silent presentation as the installed system; $root is the installer
# medium (found by the embedded config through the build-unique marker file).
set timeout=0
set timeout_style=hidden
set default=installer
set pager=0
set rb_checker=/boot/grub/retroboot/checker-default.png
set rb_gfxmode=auto
set rb_startup_style=@STARTUP_STYLE@
loadfont /boot/grub/fonts/blank.pf2
set gfxmode="$rb_gfxmode"
set gfxpayload=keep
set gfxterm_preserve_screen=1
terminal_output gfxterm
if [ "$rb_startup_style" = macosx ]; then
	background_color "#c0c0c0"
else
	background_image -m normal "$rb_checker"
fi
echo -n " "
set rb_cmdline="@CMDLINE@"
# Startup options: holding Shift at power-on shows them (ARCHITECTURE 16), in
# RetroBoot's own font (make-menu-font.py) on a plain light page. Without
# Shift, or when the font is missing, nothing changes: the first entry starts
# at once and nothing is drawn.
if keystatus --shift; then
	if loadfont /boot/grub/fonts/retroboot-menu.pf2; then
		background_image
		background_color "#dddddd"
		set gfxterm_font="RetroBoot Menu Regular 24"
		terminal_output console
		terminal_output gfxterm
		set color_normal=black/light-gray
		set menu_color_normal=black/light-gray
		set menu_color_highlight=white/dark-gray
		set timeout=60
		set timeout_style=menu
	fi
fi
menuentry "Start the RetroBoot Installer" --id installer {
	linux @LIVE@/vmlinuz boot=retroboot-live rb.live=@MARKER@ fstab=no retroboot.mode=installer@MEDIUM_ARGS@ $rb_cmdline
	initrd @LIVE@/microcode.cpio @LIVE@/initrd.img@STARTUP_INITRD@
}
# retroboot.diag=show after $rb_cmdline, which carries retroboot.diag=1 (the last one wins).
menuentry "Start and show Startup Details" --id details {
	linux @LIVE@/vmlinuz boot=retroboot-live rb.live=@MARKER@ fstab=no retroboot.mode=installer@MEDIUM_ARGS@ $rb_cmdline retroboot.diag=show
	initrd @LIVE@/microcode.cpio @LIVE@/initrd.img@STARTUP_INITRD@
}
# After $rb_cmdline, so these win over its amdgpu.dcdebugmask (the last value of a
# module option on the command line applies): PSR, PSR-SU, Panel Replay and IPS off,
# no scatter-gather display, i915 PSR off.
menuentry "Start with safe display settings" --id safe-display {
	linux @LIVE@/vmlinuz boot=retroboot-live rb.live=@MARKER@ fstab=no retroboot.mode=installer@MEDIUM_ARGS@ $rb_cmdline amdgpu.dcdebugmask=0xe10 amdgpu.sg_display=0 i915.enable_psr=0
	initrd @LIVE@/microcode.cpio @LIVE@/initrd.img@STARTUP_INITRD@
}
