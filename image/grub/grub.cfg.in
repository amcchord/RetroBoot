# RetroBoot GRUB configuration (generated by image/scripts/make-boot.sh).
#
# Nothing here may print or wait: the display shows only the firmware image,
# then the checkerboard. gfxterm is used solely to draw the background; its font
# (blank.pf2) has no visible glyphs and the cursor starts hidden (RetroBoot GRUB
# patch), so even an unexpected GRUB message cannot draw text on the screen.
# $root is the RBEFI partition this GRUB was loaded from (EFI: the image's own
# device; BIOS: prefix (,gpt1) on the BIOS boot drive).
set timeout=0
set timeout_style=hidden
set default=retroboot
set pager=0
set rb_esp="$root"
regexp --set=1:rb_disk '^([^,]+),' "$root"
set rb_checker=/grub/retroboot/checker-default.png
set rb_gfxmode=auto
# display.pixel_scale as recorded by rb-bootdisplay; passed to Linux so the
# splash and rb-presenter draw this checkerboard at the same scale.
set rb_pixel_scale=auto
# The startup indicator in the background (ARCHITECTURE 4.4.1), its guest
# layout, the checkerboard's pattern scale and the learned time of the
# cut-over: off/unknown until rb-bootdisplay has drawn them for this display.
set rb_checker_scale=0
set rb_progress=off
set rb_guest_size=auto
set rb_startup_ms=0
set rb_startup_style=classic
set rb_rotation=0
set rb_startup_initrd=
if [ -f /grub/retroboot/display.cfg ]; then source /grub/retroboot/display.cfg; fi
# For every Linux entry (ARCHITECTURE 4.4.1): the startup indicator's kernel
# arguments, and Mac OS's Happy Mac for the splash as a second (uncompressed
# cpio) initrd -- only when the file is really there, since a missing initrd
# would stop the boot. Entries append $rb_startup_args to `linux` and
# $rb_initrd_extra (unquoted: empty means no argument) to `initrd`.
set rb_startup_args="retroboot.progress=$rb_progress retroboot.guest_size=$rb_guest_size retroboot.checker_scale=$rb_checker_scale retroboot.startup_ms=$rb_startup_ms retroboot.rotation=$rb_rotation retroboot.startup_style=$rb_startup_style"
set rb_initrd_extra=
if [ -n "$rb_startup_initrd" ]; then
	if [ -f "$rb_startup_initrd" ]; then set rb_initrd_extra="$rb_startup_initrd"; fi
fi
loadfont /grub/fonts/blank.pf2
set gfxmode="$rb_gfxmode"
set gfxpayload=keep
# RetroBoot GRUB patch: do not clear the screen to black when gfxterm starts; the
# firmware image stays until the checkerboard is painted.
set gfxterm_preserve_screen=1
terminal_output gfxterm
if [ "$rb_checker" = "/grub/retroboot/checker-default.png" ]; then
	if regexp '^(640|720|800|1024|1152|1280|1360|1366)x' "$gfxmode"; then
		set rb_checker=/grub/retroboot/checker-default-s1.png
	fi
fi
background_image -m normal "$rb_checker"
# gfxterm repaints only when some cell is dirty: one (invisible) space makes the
# first swap to the screen carry the checkerboard instead of a black back buffer.
echo -n " "
# --- System slots (ARCHITECTURE section 13) ------------------------------------
# retroboot-slots: 1
# Two root filesystems, RBROOT_A (gpt3, slot a) and RBROOT_B (gpt4, slot b); Software
# Update writes the one not in use. grub/retroboot/slots.env (a GRUB environment
# block written by hostd, and here) chooses:
#   rb_active    a|b  the committed slot, the last version that proved itself
#   rb_next      a|b  a new version to try once (empty otherwise)
#   rb_tries     1|0  1: this boot tries rb_next. It is set to 0 *before* booting it,
#                     so a new version that never confirms (hostd commits it once Mac
#                     OS shows its first content) falls back to rb_active next time
#   rb_other_ok  1|0  the slot that is not active holds a working previous version
# A trial is booted only if the 0 could be saved and its kernel and initramfs load;
# otherwise this boot is the active slot's. A committed slot whose kernel can't be
# loaded falls through to the other slot when that one holds a working version. Each slot's kernel
# arguments come from grub/retroboot/slot-a.cfg / slot-b.cfg (rb_cmdline_a/_b);
# a slot without one boots with this build's arguments.
set rb_active=a
set rb_next=
set rb_tries=0
set rb_other_ok=0
set rb_envfile=
if [ -f /grub/retroboot/slots.env ]; then
	if load_env --file /grub/retroboot/slots.env rb_active rb_next rb_tries rb_other_ok; then
		set rb_envfile=/grub/retroboot/slots.env
	fi
fi
if [ -z "$rb_envfile" ]; then
	if [ -f /grub/retroboot/slots.env.bak ]; then
		if load_env --file /grub/retroboot/slots.env.bak rb_active rb_next rb_tries rb_other_ok; then
			set rb_envfile=/grub/retroboot/slots.env.bak
		fi
	fi
fi
set rb_cmdline_a="@CMDLINE@"
set rb_cmdline_b="@CMDLINE@"
if [ -f /grub/retroboot/slot-a.cfg ]; then source /grub/retroboot/slot-a.cfg; fi
if [ -f /grub/retroboot/slot-b.cfg ]; then source /grub/retroboot/slot-b.cfg; fi
if [ "$rb_active" != b ]; then set rb_active=a; fi
set rb_slot=$rb_active
set rb_trial=
if [ -n "$rb_envfile" -a "$rb_tries" = 1 ]; then
	if [ "$rb_next" = a -o "$rb_next" = b ]; then
		if [ "$rb_next" != "$rb_active" ]; then
			set rb_tries=0
			if save_env --file "$rb_envfile" rb_tries; then
				set rb_slot=$rb_next
				set rb_trial="panic=10 retroboot.trial=1"
			fi
		fi
	fi
fi
# Kernel arguments and partitions of the chosen slot ($rb_slot) and of the other one.
function rb_slot_vars {
	if [ "$rb_slot" = b ]; then
		set rb_part=gpt4
		set rb_label=RBROOT_B
		set rb_args="$rb_cmdline_b"
		set rb_other=a
		set rb_other_part=gpt3
		set rb_other_label=RBROOT_A
		set rb_other_args="$rb_cmdline_a"
	else
		set rb_part=gpt3
		set rb_label=RBROOT_A
		set rb_args="$rb_cmdline_a"
		set rb_other=b
		set rb_other_part=gpt4
		set rb_other_label=RBROOT_B
		set rb_other_args="$rb_cmdline_b"
	fi
}
rb_slot_vars
# Early microcode, the first initrd (image/reports/hostboot-2026-10-12.md): a slot's
# /boot/microcode.cfg names its microcode set (rb_ucode_id); rb-microcode keeps this
# CPU's updates from that set in grub/retroboot/ucode-<id>.cpio on the ESP. Without
# that file (first boot, a new version) the slot's full /boot/microcode.cpio; a slot
# without microcode.cfg (an older build) carries its microcode in its initramfs.
function rb_ucode_of {
	set rb_ucode=
	set rb_ucode_id=
	if [ -f ($rb_disk,$1)/boot/microcode.cfg ]; then source ($rb_disk,$1)/boot/microcode.cfg; fi
	if [ -n "$rb_ucode_id" ]; then
		if [ -f /grub/retroboot/ucode-$rb_ucode_id.cpio ]; then
			set rb_ucode=/grub/retroboot/ucode-$rb_ucode_id.cpio
		elif [ -f ($rb_disk,$1)/boot/microcode.cpio ]; then
			set rb_ucode=($rb_disk,$1)/boot/microcode.cpio
		fi
	fi
}
# A trial slot is loaded here, before the menu runs: if its kernel or initramfs can't
# be loaded, this boot is the active slot's instead. (A menu entry that fails makes
# GRUB wait for a key, and this GRUB build does not load a second kernel after a
# successful load, so the trial's entry boots what was loaded here without loading
# again. Tested under OVMF, image/reports/update-*.md.)
set rb_preloaded=0
if [ -n "$rb_trial" ]; then
	if [ -f ($rb_disk,$rb_part)/boot/initrd.img ]; then
		if linux ($rb_disk,$rb_part)/boot/vmlinuz root=PARTLABEL=$rb_label ro $rb_args $rb_startup_args retroboot.pixel_scale=$rb_pixel_scale retroboot.slot=$rb_slot $rb_trial; then
			rb_ucode_of $rb_part
			if initrd $rb_ucode ($rb_disk,$rb_part)/boot/initrd.img $rb_initrd_extra; then set rb_preloaded=1; fi
		fi
	fi
	if [ "$rb_preloaded" != 1 ]; then
		set rb_slot=$rb_active
		set rb_trial=
		rb_slot_vars
	fi
fi
# Entry 1 (by number: GRUB 2.12's fallback takes entry numbers only).
if [ "$rb_other_ok" = 1 ]; then set fallback=1; fi
menuentry RetroBoot --id retroboot {
	if [ "$rb_preloaded" != 1 ]; then
		linux ($rb_disk,$rb_part)/boot/vmlinuz root=PARTLABEL=$rb_label ro $rb_args $rb_startup_args retroboot.pixel_scale=$rb_pixel_scale retroboot.slot=$rb_slot $rb_trial
		rb_ucode_of $rb_part
		initrd $rb_ucode ($rb_disk,$rb_part)/boot/initrd.img $rb_initrd_extra
	fi
}
menuentry RetroBoot --id retroboot-fallback {
	linux ($rb_disk,$rb_other_part)/boot/vmlinuz root=PARTLABEL=$rb_other_label ro $rb_other_args $rb_startup_args retroboot.pixel_scale=$rb_pixel_scale retroboot.slot=$rb_other retroboot.fallback=1
	rb_ucode_of $rb_other_part
	initrd $rb_ucode ($rb_disk,$rb_other_part)/boot/initrd.img $rb_initrd_extra
}
