# RetroBoot Raspberry Pi image: Debian 13 everywhere, except the boot pieces that only
# the Raspberry Pi archive has (kernel for BCM2711/BCM2712 incl. Pi 5's RP1, GPU
# firmware and DTBs, the onboard CYW43455 Wi-Fi and Bluetooth firmware).
# Installed as /etc/apt/preferences.d/retroboot-raspberrypi.pref.
Package: *
Pin: origin archive.raspberrypi.com
Pin-Priority: -1

Package: raspi-firmware linux-image-rpi-v8 linux-image-*-rpi-v8 linux-base-rpi-v8 linux-base-*-rpi-v8 linux-image-rpi-2712 linux-image-*-rpi-2712 linux-base-rpi-2712 linux-base-*-rpi-2712 firmware-brcm80211 bluez-firmware
Pin: origin archive.raspberrypi.com
Pin-Priority: 990
