+/*
+ * RetroBoot (MT6797 A72): speed bin from LK's devinfo copy (nvmem cells
+ * "func-code" = devinfo[22], "date-code" = devinfo[61]), decoded like vendor
+ * mt_cpufreq.c _mt_cpufreq_get_cpu_level() / _mt_cpufreq_get_cpu_date_code():
+ * function code 1 (bits 3:0): 0/3 FY, 1/6 SB, 4 SB + TT segment, 2/7 M,
+ * 15 L, else FY; date code (devinfo[61] bits 7:4) < 7 = table 1221, else
+ * 0119. (The vendor also forces M when the DT A72 clock-frequency is
+ * 1989 MHz; this DT says 2288.) opp-supported-hw bits:
+ *   BIT(0) SB 0119, BIT(1) SB 0119 TT segment, BIT(2) any other or unknown
+ * bin; other bins get only the OPPs marked for them.
+ */
+static int mtk_cpufreq_set_speed_bin(struct mtk_cpu_dvfs_info *info, int cpu)
+{
+	static const char * const lvname[] = { "FY", "SB", "M", "L" };
+	struct device *dev = info->cpu_dev;
+	u32 fc = 0, dc = 0;
+	unsigned int fc1, date, lv = 0;
+	int ret;
+
+	if (!of_property_present(dev->of_node, "nvmem-cells"))
+		return 0;
+
+	ret = nvmem_cell_read_u32(dev, "func-code", &fc);
+	if (!ret)
+		ret = nvmem_cell_read_u32(dev, "date-code", &dc);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+
+	if (ret) {
+		info->opp_hw = BIT(2);
+		dev_warn(dev, "cpu%d: speed bin unreadable (%d): unknown-bin OPPs only\n",
+			 cpu, ret);
+	} else {
+		fc1 = fc & 0xf;
+		date = (dc >> 4) & 0xf;
+		switch (fc1) {
+		case 1: case 6: case 4:
+			lv = 1;
+			break;
+		case 2: case 7:
+			lv = 2;
+			break;
+		case 15:
+			lv = 3;
+			break;
+		default:
+			lv = 0;
+			break;
+		}
+		if (lv == 1 && date >= 7)
+			info->opp_hw = fc1 == 4 ? BIT(1) : BIT(0);
+		else
+			info->opp_hw = BIT(2);
+		dev_info(dev,
+			 "A72 speed bin: devinfo[22]=0x%08x (function code %u: level %u %s%s), devinfo[61]=0x%08x (date code %u: table %s) -> OPP set 0x%x (%s)\n",
+			 fc, fc1, lv, lvname[lv], fc1 == 4 ? ", TT segment" : "", dc, date,
+			 date >= 7 ? "0119" : "1221", info->opp_hw,
+			 info->opp_hw == BIT(0) ? "SB 0119" :
+			 info->opp_hw == BIT(1) ? "SB 0119 TT" : "other bin: up to 1495 MHz");
+	}
+
+	ret = dev_pm_opp_set_supported_hw(dev, &info->opp_hw, 1);
+	if (ret < 0) {
+		dev_err(dev, "cpu%d: opp-supported-hw: %d\n", cpu, ret);
+		return ret;
+	}
+	info->opp_token = ret;
+	return 0;
+}
