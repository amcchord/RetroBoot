--- a/drivers/regulator/mt6797-sramldo-b-regulator.c
+++ b/drivers/regulator/mt6797-sramldo-b-regulator.c
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * mt6797-sramldo-b-regulator.c - the MT6797 A72 cluster's SRAM LDO
+ * (VSRAM_B) as a regulator, so mediatek-cpufreq can track it against VPROC2
+ * (RetroBoot, Gemini PDA, 2026-10-14).
+ *
+ * The LDO sits in MCUCFG2 and the kernel reaches it only through ATF
+ * (gemian/gemini-linux-kernel-3.18 drivers/misc/mediatek/base/power/mt6797/
+ * mt_idvfs.c):
+ *
+ *  - set: SiP SMC 0xC20003BF (MTK_SIP_KERNEL_IDVFS_BIGIDVFSSRAMLDOSET),
+ *    argument mV x 100, vendor range check 500..1200 mV
+ *    (BigiDVFSSRAMLDOSet()). mt6797-cl2-power uses the same call (1.1 V)
+ *    before the cluster's CPU_ON.
+ *  - get: the vendor never calls the SRAMLDOGET SMC 0xC20003C0 (its reply
+ *    format is undocumented), so neither does this driver. Vendor
+ *    BigiDVFSSRAMLDOGet() reads 0x102222b0 through the secure-read SMC
+ *    0xC200035F, vosel[3:0]: 0 = 1.05 V, 1 = 0.6 V, 2 = 0.7 V,
+ *    n >= 3 = 0.9 V + (n - 3) x 25 mV, and only while cpu8/cpu9 are online.
+ *
+ * Selectors are the vosel values 3..15 (0.9..1.2 V, 25 mV grid), so ATF is
+ * only ever asked for a voltage it can represent exactly. Hard limits that
+ * do not depend on the DT: 1.0..1.2 V (vendor MIN/MAX_VSRAM_VOLT).
+ * get_voltage_sel() returns the last value set (1.1 V until the first set:
+ * what mt6797-cl2-power programs); after every set, if an A72 is online, the
+ * vosel is read back and must decode to the requested voltage.
+ * Settling: vendor PMIC_VOLT_UP/DOWN_SETTLE_TIME, at least 25 us
+ * (MIN_PMIC_SETTLE_TIME), via set_voltage_time_sel().
+ *
+ * DT:
+ *   vsram_b: regulator-vsram-b {
+ *       compatible = "mediatek,mt6797-sramldo-b";
+ *       regulator-name = "vsram_b";
+ *       regulator-min-microvolt = <1000000>;
+ *       regulator-max-microvolt = <1200000>;
+ *       cpus = <&cpu8>, <&cpu9>;
+ *   };
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/cpumask.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+#include <linux/regulator/of_regulator.h>
+
+#define SIP_IDVFS_READ			0xC200035FUL
+#define SIP_IDVFS_SRAMLDO_SET		0xC20003BFUL
+#define B_SRAMLDO_REG			0x102222b0UL
+
+#define SRAMLDO_HARD_MIN_UV		1000000
+#define SRAMLDO_HARD_MAX_UV		1200000
+#define SRAMLDO_BOOT_SEL		11	/* 0.9 V + 8 x 25 mV = 1.1 V (cl2-power) */
+#define SRAMLDO_MIN_SETTLE_US		25
+
+struct sramldo_b {
+	struct regulator_desc desc;
+	cpumask_t cpus;
+	unsigned int sel;
+};
+
+static const struct linear_range sramldo_b_range[] = {
+	REGULATOR_LINEAR_RANGE(900000, 3, 15, 25000),
+};
+
+static int sramldo_b_vosel_uv(unsigned int vosel)
+{
+	switch (vosel) {
+	case 0:
+		return 1050000;
+	case 1:
+		return 600000;
+	case 2:
+		return 700000;
+	default:
+		return 900000 + (vosel - 3) * 25000;
+	}
+}
+
+static int sramldo_b_get_voltage_sel(struct regulator_dev *rdev)
+{
+	struct sramldo_b *s = rdev_get_drvdata(rdev);
+
+	return s->sel;
+}
+
+static int sramldo_b_set_voltage_sel(struct regulator_dev *rdev, unsigned int sel)
+{
+	struct sramldo_b *s = rdev_get_drvdata(rdev);
+	struct arm_smccc_res res;
+	int uv = regulator_list_voltage_linear_range(rdev, sel);
+	int got;
+
+	if (uv < SRAMLDO_HARD_MIN_UV || uv > SRAMLDO_HARD_MAX_UV) {
+		dev_err(&rdev->dev, "refusing VSRAM_B %d uV (limits %d..%d)\n",
+			uv, SRAMLDO_HARD_MIN_UV, SRAMLDO_HARD_MAX_UV);
+		return -EINVAL;
+	}
+
+	arm_smccc_smc(SIP_IDVFS_SRAMLDO_SET, uv / 10, 0, 0, 0, 0, 0, 0, &res);
+	if (res.a0) {
+		dev_err(&rdev->dev, "SRAM LDO SMC (%d uV) returned 0x%lx\n", uv, res.a0);
+		return -EIO;
+	}
+	s->sel = sel;
+
+	/*
+	 * Read back the way the vendor does, only while the cluster runs.
+	 * No cpus_read_lock(): cpufreq calls this with the policy rwsem held,
+	 * and it only retunes an online policy.
+	 */
+	if (cpumask_intersects(&s->cpus, cpu_online_mask)) {
+		arm_smccc_smc(SIP_IDVFS_READ, B_SRAMLDO_REG, 0, 0, 0, 0, 0, 0, &res);
+		got = sramldo_b_vosel_uv(res.a0 & 0xf);
+		if (got != uv) {
+			dev_err(&rdev->dev, "VSRAM_B readback %d uV (vosel %lu) != %d uV\n",
+				got, res.a0 & 0xf, uv);
+			return -EIO;
+		}
+	}
+	dev_dbg(&rdev->dev, "VSRAM_B %d uV\n", uv);
+	return 0;
+}
+
+/* vendor PMIC_VOLT_UP/DOWN_SETTLE_TIME (volt in 10 uV units), min 25 us */
+static int sramldo_b_set_voltage_time_sel(struct regulator_dev *rdev,
+					  unsigned int old_sel, unsigned int new_sel)
+{
+	int old_uv = regulator_list_voltage_linear_range(rdev, old_sel);
+	int new_uv = regulator_list_voltage_linear_range(rdev, new_sel);
+	int us;
+
+	if (old_uv < 0 || new_uv < 0)
+		return SRAMLDO_MIN_SETTLE_US;
+	if (new_uv >= old_uv)
+		us = DIV_ROUND_UP((new_uv - old_uv) / 10, 1250) + 5;
+	else
+		us = ((old_uv - new_uv) / 10) * 2 / 625 + 5;
+	return max(us, SRAMLDO_MIN_SETTLE_US);
+}
+
+static const struct regulator_ops sramldo_b_ops = {
+	.list_voltage = regulator_list_voltage_linear_range,
+	.map_voltage = regulator_map_voltage_linear_range,
+	.get_voltage_sel = sramldo_b_get_voltage_sel,
+	.set_voltage_sel = sramldo_b_set_voltage_sel,
+	.set_voltage_time_sel = sramldo_b_set_voltage_time_sel,
+};
+
+static int sramldo_b_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config cfg = { };
+	struct regulator_dev *rdev;
+	struct sramldo_b *s;
+	int i;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+
+	for (i = 0; ; i++) {
+		struct device_node *np = of_parse_phandle(dev->of_node, "cpus", i);
+		int cpu;
+
+		if (!np)
+			break;
+		cpu = of_cpu_node_to_id(np);
+		of_node_put(np);
+		if (cpu < 0)
+			return dev_err_probe(dev, cpu, "cpus[%d]\n", i);
+		cpumask_set_cpu(cpu, &s->cpus);
+	}
+	if (cpumask_empty(&s->cpus))
+		return dev_err_probe(dev, -EINVAL, "no cpus\n");
+
+	s->sel = SRAMLDO_BOOT_SEL;
+	s->desc.name = "vsram_b";
+	s->desc.of_match = NULL;
+	s->desc.type = REGULATOR_VOLTAGE;
+	s->desc.owner = THIS_MODULE;
+	s->desc.ops = &sramldo_b_ops;
+	s->desc.n_voltages = 16;
+	s->desc.linear_ranges = sramldo_b_range;
+	s->desc.n_linear_ranges = ARRAY_SIZE(sramldo_b_range);
+
+	cfg.dev = dev;
+	cfg.of_node = dev->of_node;
+	cfg.driver_data = s;
+	cfg.init_data = of_get_regulator_init_data(dev, dev->of_node, &s->desc);
+	if (!cfg.init_data)
+		return -ENOMEM;
+	if (cfg.init_data->constraints.max_uV > SRAMLDO_HARD_MAX_UV ||
+	    cfg.init_data->constraints.min_uV < SRAMLDO_HARD_MIN_UV)
+		return dev_err_probe(dev, -EINVAL, "DT range outside %d..%d uV\n",
+				     SRAMLDO_HARD_MIN_UV, SRAMLDO_HARD_MAX_UV);
+
+	rdev = devm_regulator_register(dev, &s->desc, &cfg);
+	if (IS_ERR(rdev))
+		return dev_err_probe(dev, PTR_ERR(rdev), "register\n");
+
+	dev_info(dev, "A72 SRAM LDO via SiP SMC, %d..%d uV, assumed %d uV (cl2-power)\n",
+		 cfg.init_data->constraints.min_uV, cfg.init_data->constraints.max_uV,
+		 900000 + (SRAMLDO_BOOT_SEL - 3) * 25000);
+	return 0;
+}
+
+static const struct of_device_id sramldo_b_of_match[] = {
+	{ .compatible = "mediatek,mt6797-sramldo-b" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sramldo_b_of_match);
+
+static struct platform_driver sramldo_b_driver = {
+	.probe = sramldo_b_probe,
+	.driver = {
+		.name = "mt6797-sramldo-b",
+		.of_match_table = sramldo_b_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+module_platform_driver(sramldo_b_driver);
+
+MODULE_DESCRIPTION("MT6797 A72 SRAM LDO (VSRAM_B) via ATF SiP SMC");
+MODULE_LICENSE("GPL");
