RetroBoot a72dvfs2: MT6797 thermal glitch filter (one-reading hold of upward jumps)

Applied by build-kernel.sh --variant a72dvfs2 after the a72dvfs variant, on top of
gemini-nixos 6a172f5's kernel delta (GPL-2.0). drivers/thermal/mediatek/auxadc_thermal.c:
soc-thermal is the maximum of the six banks; on glass it once read 99.2 C for one sample
between 69.9 and 78.1 C. A spike like that above 105 C would trigger the critical trip.

- Rule. An upward jump of more than glitch_delta_mc (15 C) over the last accepted value
  is held (the last value is reported) until a reading at least glitch_confirm_ms (200 ms)
  later is still above the threshold. Readings within the threshold, drops and invalid
  readings pass at once.
- Guarantee. A temperature present in two consecutive thermal-core polls (250 ms or 1 s
  apart) is reported by the second one: at most one poll of delay, never hidden.
- Logging and tuning. Each hold and confirmation is logged (ratelimited) with the bank.
  Both parameters can be changed at runtime in /sys/module/auxadc_thermal/parameters;
  0 turns the filter off.
- Scope. Only the MT6797 (V4) path changes.

--- a/drivers/thermal/mediatek/auxadc_thermal.c
+++ b/drivers/thermal/mediatek/auxadc_thermal.c
@@ -19,6 +19,7 @@
 #include <linux/slab.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
+#include <linux/ktime.h>
 #include <linux/thermal.h>
 #include <linux/reset.h>
 #include <linux/types.h>
@@ -365,6 +366,65 @@
 	u32 adcvalidmask;
 };
 
+/*
+ * RetroBoot (MT6797, Gemini PDA): one-reading glitch filter on the zone
+ * temperature. On glass soc-thermal once read 99.2 C for a single sample
+ * between 69.9 and 78.1 C; such a spike above the 105 C critical trip would
+ * power the device off. An upward jump of more than @delta over the last
+ * accepted value is held (the last accepted value is reported) until it is
+ * confirmed by a reading taken at least @confirm_ms later that is still
+ * above the threshold; any reading within the threshold is accepted at once.
+ * Downward changes and invalid readings pass unchanged.
+ *
+ * Guarantee: a temperature that persists over two readings taken
+ * @confirm_ms or more apart is reported by the second one. The zone polls
+ * every 250 ms (passive) or 1 s, so every thermal-core poll after a held one
+ * confirms or rejects it: at most one poll of delay, never a hidden
+ * over-temperature. Reads closer together (sysfs, hwmon) cannot confirm a
+ * spike that is still latched in the measurement registers (updated every
+ * ~20-80 ms by the controller). The code between the markers is compiled
+ * unchanged by the RetroBoot unit test (variants/a72dvfs2/test-glitch-filter.c).
+ */
+/* glitch-filter-begin */
+struct mtk_temp_filter {
+	int last;		/* last accepted mC; INT_MIN = none yet */
+	s64 held_since_ms;	/* time of the first held reading; 0 = none */
+};
+
+static int mtk_temp_filter_apply(struct mtk_temp_filter *f, int temp, s64 now_ms,
+				 int delta, int confirm_ms, bool *held)
+{
+	*held = false;
+	if (temp == THERMAL_TEMP_INVALID)
+		return temp;
+	if (delta <= 0 || f->last == INT_MIN || temp <= f->last + delta) {
+		f->last = temp;
+		f->held_since_ms = 0;
+		return temp;
+	}
+	if (!f->held_since_ms) {
+		f->held_since_ms = now_ms > 0 ? now_ms : 1;
+		*held = true;
+		return f->last;
+	}
+	if (now_ms - f->held_since_ms < confirm_ms) {
+		*held = true;
+		return f->last;
+	}
+	f->last = temp;
+	f->held_since_ms = 0;
+	return temp;
+}
+/* glitch-filter-end */
+
+/* 0 disables the filter; writable at runtime in /sys/module/auxadc_thermal/parameters */
+static int glitch_delta_mc = 15000;
+module_param(glitch_delta_mc, int, 0644);
+MODULE_PARM_DESC(glitch_delta_mc, "MT6797: hold an upward jump larger than this (mC) for one reading (0 = off)");
+static int glitch_confirm_ms = 200;
+module_param(glitch_confirm_ms, int, 0644);
+MODULE_PARM_DESC(glitch_confirm_ms, "MT6797: a held jump is accepted by a reading at least this much later");
+
 struct mtk_thermal {
 	struct device *dev;
 	void __iomem *thermal_base;
@@ -386,6 +446,10 @@
 	struct mtk_thermal_bank banks[MAX_NUM_ZONES];
 
 	int (*raw_to_mcelsius)(struct mtk_thermal *mt, int sensno, s32 raw);
+
+	/* RetroBoot MT6797 glitch filter, see mtk_temp_filter_apply() */
+	struct mutex filter_lock;
+	struct mtk_temp_filter filter;
 };
 
 /* MT8183 thermal sensor data */
@@ -977,7 +1041,7 @@
 static int mtk_read_temp(struct thermal_zone_device *tz, int *temperature)
 {
 	struct mtk_thermal *mt = thermal_zone_device_priv(tz);
-	int i;
+	int i, t, hot_bank = -1;
 	int tempmax = INT_MIN;
 
 	for (i = 0; i < mt->conf->num_banks; i++) {
@@ -985,11 +1049,36 @@
 
 		mtk_thermal_get_bank(bank);
 
-		tempmax = max(tempmax, mtk_thermal_bank_temperature(bank));
+		t = mtk_thermal_bank_temperature(bank);
+		if (t > tempmax) {
+			tempmax = t;
+			hot_bank = i;
+		}
 
 		mtk_thermal_put_bank(bank);
 	}
 
+	if (mt->conf->version == MTK_THERMAL_V4) {
+		int last, reported;
+		bool held;
+
+		mutex_lock(&mt->filter_lock);
+		last = mt->filter.last;
+		reported = mtk_temp_filter_apply(&mt->filter, tempmax, ktime_to_ms(ktime_get()),
+						 READ_ONCE(glitch_delta_mc),
+						 READ_ONCE(glitch_confirm_ms), &held);
+		mutex_unlock(&mt->filter_lock);
+		if (held)
+			dev_warn_ratelimited(mt->dev,
+					     "reading %d mC (bank %d) jumps over %d mC from %d mC: held for one reading\n",
+					     tempmax, hot_bank, READ_ONCE(glitch_delta_mc), last);
+		else if (reported == tempmax && last != INT_MIN &&
+			 tempmax > last + READ_ONCE(glitch_delta_mc) && READ_ONCE(glitch_delta_mc) > 0)
+			dev_warn_ratelimited(mt->dev, "jump to %d mC (bank %d) confirmed\n",
+					     tempmax, hot_bank);
+		tempmax = reported;
+	}
+
 	*temperature = tempmax;
 
 	return 0;
@@ -1538,6 +1627,10 @@
 	else
 		mt->raw_to_mcelsius = raw_to_mcelsius_v3;
 
+	mutex_init(&mt->filter_lock);
+	mt->filter.last = INT_MIN;
+	mt->filter.held_since_ms = 0;
+
 	if (mt->conf->version == MTK_THERMAL_V4)
 		mtk_thermal_v4_init(mt, auxadc_base, apmixed_phys_base,
 				    auxadc_phys_base);
