diff -ruN a/drivers/usb/typec/Kconfig b/drivers/usb/typec/Kconfig
--- a/drivers/usb/typec/Kconfig
+++ b/drivers/usb/typec/Kconfig
@@ -123,3 +123,14 @@
 	  Driver for the ON Semiconductor FUSB301A USB Type-C CC-only
 	  controller. Detects connector orientation and reports attach/detach
 	  to the USB role switch framework. Used on the Gemini PDA.
+
+config TYPEC_GEMINI_RIGHT_PORT
+	bool "Gemini PDA right USB-C port VBUS policy (FUSB301A on i2c0)"
+	depends on I2C=y && GPIOLIB && OF && TYPEC=y
+	help
+	  The Planet Computers Gemini PDA's right USB-C port has its own 5 V
+	  source (GPIO94) and load switch (GPIO72) and no charge path. This
+	  keeps its FUSB301A CC controller in SOURCE mode and switches VBUS
+	  on only while a USB device (Rd) is attached, never for a charger.
+	  Built in, so the policy runs before userspace. (drivers/usb/typec/
+	  is only built with TYPEC=y.)
