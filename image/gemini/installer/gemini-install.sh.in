#!/bin/sh
# RetroBoot @VERSION@ for the Planet Computers Gemini PDA: installer (@BUILD_ID@, @SUFFIX@).
# Generated by image/gemini/scripts/make-payload.sh; run as root on the Gemini, from the
# directory that holds this build's payload, under Gemian (Debian 9) or RetroBoot itself.
#
#   gemini-install.sh [--activate] [--keep-data] [--linux-root DIR]
#        Install: check every payload hash; unpack the root into <linux>@ROOT_DIR@.new; swap
#        it into place (the previous tree stays as <linux>@ROOT_DIR@.old); write boot.img to
#        the PARTNAME=@PART_BOOT@ partition and read it back; reset the boot-attempt counter.
#        --activate also clears para (32 NUL bytes), so the bootloader boots RetroBoot
#        from now on; without it para stays as it is (when it says boot-recovery, Gemian
#        keeps booting until you activate).
#        --keep-data copies the existing Macs, settings and Wi-Fi networks into the
#        new tree. Run the upgrade from Gemian so Mac disks are closed.
#   gemini-install.sh --rollback [recovery]
#        para = boot-recovery: the next boot starts Gemian (recovery partition).
#   gemini-install.sh --rollback previous
#        Swap @ROOT_DIR@ and @ROOT_DIR@.old back and write the restored tree's own boot.img.
#   gemini-install.sh --status       trees, boot partition, para, counter
#   gemini-install.sh --verify       payload hashes only
#
# <linux> is the root of the ext4 file system on PARTNAME=@PART_LINUX@ (Gemian's /; under
# RetroBoot the installer finds or mounts it). Partitions are found by GPT name on the
# internal eMMC, never by number. Nothing else is written: never nvram, nvdata or any
# other partition. Gemian itself is not touched.
set -u
PROG=gemini-install.sh
VERSION='@VERSION@'
BUILD_ID='@BUILD_ID@'
ROOTFS='@ROOTFS@'
ROOTFS_BYTES='@ROOTFS_BYTES@'
BOOTIMG='@BOOTIMG@'
BOOTIMG_SHA256='@BOOTIMG_SHA256@'
ROOT_DIR='@ROOT_DIR@'
PART_BOOT='@PART_BOOT@'
PART_PARA='@PART_PARA@'
PART_LINUX='@PART_LINUX@'
COUNTER_FILE='@COUNTER_FILE@'
COUNTER_RESET='@COUNTER_RESET@'
TREE_BOOTIMG=/usr/lib/retroboot/gemini/boot/boot.img
BACKUP_DIR=/retroboot-boot-backup

# ---- partitions and para (image/gemini/rootfs/usr/lib/retroboot/gemini/gemini-part.sh) ----
@GEMINI_PART_LIB@
# ---------------------------------------------------------------------------------------

say() { echo "$PROG: $*"; }
die() { echo "$PROG: ERROR: $*" >&2; cleanup; exit 1; }
MOUNTED=
cleanup() {
  if [ -n "$MOUNTED" ]; then umount "$MOUNTED" 2>/dev/null || umount -l "$MOUNTED" 2>/dev/null; rmdir "$MOUNTED" 2>/dev/null; MOUNTED=; fi
}
trap 'cleanup' EXIT
trap 'die "interrupted"' INT TERM HUP

HERE=$(cd "$(dirname "$0")" && pwd)

need_tools() {
  for t in sha256sum dd cmp od mount umount sync stat df du awk sed mv rm mkdir cp install; do
    command -v "$t" >/dev/null 2>&1 || die "missing tool: $t"
  done
  # GNU tar by path: a busybox shell may prefer its own tar applet, which lacks xattrs.
  TAR=
  for t in /bin/tar /usr/bin/tar /usr/local/bin/tar; do
    [ -x "$t" ] && "$t" --version 2>/dev/null | head -n1 | grep -q 'GNU tar' && { TAR=$t; break; }
  done
  [ -n "$TAR" ] || die "GNU tar is required (xattrs, sparse files, numeric owners)"
}

verify_payload() {
  [ -f "$HERE/SHA256SUMS" ] || die "no SHA256SUMS next to the installer"
  (cd "$HERE" && sha256sum -c SHA256SUMS >/dev/null) || die "payload hash check failed (copy the build again)"
  [ "$(sha256sum "$HERE/$BOOTIMG" | cut -d' ' -f1)" = "$BOOTIMG_SHA256" ] || die "$BOOTIMG does not match the build"
  say "payload hashes OK ($ROOTFS, $BOOTIMG, rb-unzstd)"
}

# The decompressor: the system's zstd when it can read this payload, else the shipped one.
unzstd_cmd() {
  if [ "${RB_INSTALL_FORCE_SHIPPED_UNZSTD:-0}" != 1 ] && command -v zstd >/dev/null 2>&1 && zstd -t -q "$HERE/$ROOTFS" 2>/dev/null; then
    echo "zstd -dc"
  else
    chmod 0755 "$HERE/rb-unzstd" 2>/dev/null
    "$HERE/rb-unzstd" --version >/dev/null 2>&1 || die "neither zstd nor the shipped rb-unzstd works here"
    echo "$HERE/rb-unzstd"
  fi
}

find_parts() {
  BOOT=$(rbg_part "$PART_BOOT") || die "no PARTNAME=$PART_BOOT partition on the internal eMMC"
  PARA=$(rbg_part "$PART_PARA") || die "no PARTNAME=$PART_PARA partition"
  LINUX=$(rbg_part "$PART_LINUX") || die "no PARTNAME=$PART_LINUX partition"
  d=$(rbg_disk_of "$BOOT"); [ "$(rbg_disk_of "$PARA")" = "$d" ] && [ "$(rbg_disk_of "$LINUX")" = "$d" ] ||
    die "$PART_BOOT, $PART_PARA and $PART_LINUX are not on the same disk"
  BOOT_BYTES=$(( $(cat "/sys/class/block/${BOOT##*/}/size") * 512 ))
  [ "$BOOT_BYTES" -le 67108864 ] || die "$BOOT is $BOOT_BYTES bytes: not the 16 MiB boot partition"
}

# LFS: the root of the linux file system (a mount whose root is the file system's root).
find_lfs() {
  if [ -n "${LINUX_ROOT:-}" ]; then LFS=$LINUX_ROOT; return; fi
  mm=$(cat "/sys/class/block/${LINUX##*/}/dev")
  LFS=$(awk -v mm="$mm" '$3 == mm && $4 == "/" {print $5; exit}' /proc/self/mountinfo)
  if [ -z "$LFS" ]; then
    MOUNTED=/run/retroboot-install.$$
    mkdir -p "$MOUNTED" && mount -o rw,noatime "$LINUX" "$MOUNTED" || { MOUNTED=; die "cannot mount $LINUX"; }
    LFS=$MOUNTED
  fi
  [ "$LFS" = / ] && LFS=
  [ -w "$LFS/" ] || die "the linux file system (${LFS:-/}) is not writable"
}

tree_build() { # build id of a tree, or "-"
  sed -n 's/.*"build_id": *"\([^"]*\)".*/\1/p' "$1/usr/lib/retroboot/release.json" 2>/dev/null | head -n1 | grep . || echo -
}

is_running_root() { # true when DIR is the tree this system runs from
  [ -d "$1" ] || return 1
  [ "$(stat -c '%d:%i' "$1")" = "$(stat -c '%d:%i' /)" ]
}

dev_sha256() { # DEV BYTES: sha256 of the first BYTES bytes, read past the page cache
  if [ $(( $2 % 512 )) -eq 0 ] && dd if="$1" of=/dev/null bs=512 count=1 iflag=direct 2>/dev/null; then
    dd if="$1" bs=512 count=$(( $2 / 512 )) iflag=direct 2>/dev/null | sha256sum | cut -d' ' -f1
  else
    sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
    dd if="$1" bs=512 count=$(( ($2 + 511) / 512 )) 2>/dev/null | head -c "$2" | sha256sum | cut -d' ' -f1
  fi
}

write_bootimg() { # IMAGE: write to the boot partition and verify by readback
  img=$1; size=$(stat -c %s "$img"); want=$(sha256sum "$img" | cut -d' ' -f1)
  [ "$size" -le "$BOOT_BYTES" ] || die "$img ($size bytes) is larger than $BOOT ($BOOT_BYTES bytes)"
  if [ "$(dev_sha256 "$BOOT" "$size")" = "$want" ]; then
    say "boot partition $BOOT already holds this boot.img"
  else
    dd if="$img" of="$BOOT" bs=1M conv=fsync 2>/dev/null || die "writing $BOOT failed"
    sync
  fi
  got=$(dev_sha256 "$BOOT" "$size")
  [ "$got" = "$want" ] || die "boot partition readback $got differs from boot.img $want: run '$PROG --rollback' before rebooting"
  say "boot partition $BOOT: boot.img written and read back ($size bytes, sha256 ${want%"${want#????????????????}"}...)"
}

reset_counter() {
  f=$LFS$COUNTER_FILE
  if [ -z "$COUNTER_RESET" ]; then rm -f "$f"; else printf '%s\n' "$COUNTER_RESET" > "$f.new" && mv -f "$f.new" "$f"; fi || die "cannot reset $f"
  sync
  say "boot-attempt counter $COUNTER_FILE reset (${COUNTER_RESET:-removed})"
}

para_state() {
  c=$(rbg_para_read "$PARA")
  case "$c" in
    '') echo "empty: the bootloader boots $PART_BOOT (RetroBoot)" ;;
    boot-recovery) echo "boot-recovery: the bootloader boots recovery (Gemian)" ;;
    *) echo "'$c'" ;;
  esac
}

do_status() {
  find_parts; find_lfs
  echo "partitions: $PART_BOOT=$BOOT $PART_PARA=$PARA $PART_LINUX=$LINUX (linux file system at ${LFS:-/})"
  for t in "$ROOT_DIR" "$ROOT_DIR.old" "$ROOT_DIR.new"; do
    [ -d "$LFS$t" ] && echo "tree $t: build $(tree_build "$LFS$t")$(is_running_root "$LFS$t" && echo ' (running)')"
  done
  if [ -f "$LFS$ROOT_DIR$TREE_BOOTIMG" ]; then
    s=$(stat -c %s "$LFS$ROOT_DIR$TREE_BOOTIMG")
    [ "$(dev_sha256 "$BOOT" "$s")" = "$(sha256sum "$LFS$ROOT_DIR$TREE_BOOTIMG" | cut -d' ' -f1)" ] &&
      echo "boot partition: the boot.img of $ROOT_DIR" || echo "boot partition: NOT the boot.img of $ROOT_DIR"
  fi
  echo "para: $(para_state)"
  echo "boot-attempt counter $COUNTER_FILE: $(cat "$LFS$COUNTER_FILE" 2>/dev/null || echo absent)"
  [ ! -e "$LFS/.retroboot-fallback" ] || echo "the initrd fell back to Gemian at least once: $LFS/.retroboot-fallback ($(cat "$LFS/.retroboot-fallback" 2>/dev/null | head -n1))"
  [ ! -e "$LFS/.retroboot-initrd.log" ] || echo "initrd log of the last boot: $LFS/.retroboot-initrd.log"
}

do_install() {
  verify_payload
  find_parts; find_lfs
  new=$LFS$ROOT_DIR.new; cur=$LFS$ROOT_DIR; old=$LFS$ROOT_DIR.old
  is_running_root "$new" && die "$ROOT_DIR.new is the running system"
  is_running_root "$old" && die "$ROOT_DIR.old is the running system; start Gemian first"
  is_running_root "$cur" && die "start Gemian before installing so all Mac disks are closed"
  if [ -d "$cur/var/lib/retroboot" ] && [ "$KEEP_DATA" != 1 ]; then
    die "RetroBoot is already installed. Run again with --keep-data to upgrade."
  fi
  unz=$(unzstd_cmd)
  need=$(( ROOTFS_BYTES / 1024 + 1048576 ))
  if [ "$KEEP_DATA" = 1 ] && [ -d "$cur/var/lib/retroboot" ]; then
    data_kib=$(du -sk "$cur/var/lib/retroboot" | awk '{print $1}')
    need=$((need + data_kib))
  fi
  avail=$(df -Pk "${LFS:-/}" | awk 'NR == 2 {print $4}')
  [ "$avail" -gt "$need" ] || die "${LFS:-/} has $avail KiB free, needs $need KiB"
  say "unpacking $ROOTFS into ${new} (decompressor: ${unz##*/})"
  rm -rf "$new"; mkdir -p "$new" || die "cannot create $new"
  chmod 0755 "$new"
  $unz < "$HERE/$ROOTFS" | "$TAR" -x -p --numeric-owner --xattrs --xattrs-include='*' -f - -C "$new" ||
    die "unpacking failed ($new is left for inspection; nothing else changed)"
  [ "$(tree_build "$new")" = "$BUILD_ID" ] || die "the unpacked tree is not build $BUILD_ID"
  [ -x "$new/usr/lib/systemd/systemd" ] && { [ -L "$new/usr/sbin/init" ] || [ -x "$new/usr/sbin/init" ]; } ||
    die "the unpacked tree has no /sbin/init"
  [ -f "$new$TREE_BOOTIMG" ] && cmp -s "$new$TREE_BOOTIMG" "$HERE/$BOOTIMG" || die "the tree's boot.img differs from $BOOTIMG"
  sync
  if [ "$KEEP_DATA" = 1 ] && [ -d "$cur/var/lib/retroboot" ]; then
    cp -a --sparse=always "$cur/var/lib/retroboot/." "$new/var/lib/retroboot/" ||
      die "--keep-data: copying the data failed (the existing installation is intact)"
    # Prior Gemini builds stored the download sign-in with the operating system.
    auth="$cur/etc/retroboot/lab-auth.env"
    if [ -f "$auth" ] && [ ! -L "$auth" ]; then
      dst="$new/var/lib/retroboot/config"
      install -m 0600 "$auth" "$dst/lab-auth.env" ||
        die "--keep-data: copying the download sign-in failed"
    fi
    for stored in var/lib/bluetooth var/lib/gemini-gauge; do
      if [ -d "$cur/$stored" ] && [ ! -L "$cur/$stored" ]; then
        mkdir -p "$new/$stored" &&
          cp -a "$cur/$stored/." "$new/$stored/" || die "--keep-data: copying $stored failed"
      fi
    done
    say "copied Macs, settings and networks; the previous installation retains its data"
    sync
  fi
  if [ -d "$cur" ]; then
    if [ -d "$old" ]; then
      is_running_root "$old" && die "$ROOT_DIR.old is the running system; reboot first"
      rm -rf "$old" || die "cannot remove the older $ROOT_DIR.old"
    fi
    mv "$cur" "$old" || die "cannot move $ROOT_DIR to $ROOT_DIR.old"
  fi
  mv "$new" "$cur" || { [ -d "$old" ] && mv "$old" "$cur"; die "cannot move $ROOT_DIR.new into place (previous tree restored)"; }
  sync
  say "$ROOT_DIR is build $BUILD_ID$( [ -d "$old" ] && echo "; the previous tree is $ROOT_DIR.old ($(tree_build "$old"))")"
  # The boot partition as found before the first RetroBoot install (Gemian's kernel), once.
  mkdir -p "$LFS$BACKUP_DIR"
  if [ ! -f "$LFS$BACKUP_DIR/boot-before-retroboot.img" ] && [ ! -d "$old" ]; then
    dd if="$BOOT" of="$LFS$BACKUP_DIR/boot-before-retroboot.img.tmp" bs=1M 2>/dev/null &&
      mv "$LFS$BACKUP_DIR/boot-before-retroboot.img.tmp" "$LFS$BACKUP_DIR/boot-before-retroboot.img" &&
      say "saved the boot partition as found in $BACKUP_DIR/boot-before-retroboot.img"
  fi
  write_bootimg "$HERE/$BOOTIMG"
  reset_counter
  if [ "$ACTIVATE" = 1 ]; then
    rbg_para_clear "$PARA" || die "clearing para failed"
    say "para cleared: the bootloader boots RetroBoot from now on"
  fi
  sync
  say "para: $(para_state)"
  if [ -z "$(rbg_para_read "$PARA")" ]; then
    say "done: the next boot starts RetroBoot build $BUILD_ID (reboot when ready)."
  else
    say "done: build $BUILD_ID is installed; para still selects another boot (--activate, or rb-gemini-boot-target retroboot)."
  fi
}

do_rollback() {
  find_parts
  case "${1:-recovery}" in
  recovery)
    rbg_para_write "$PARA" boot-recovery || die "writing para failed"
    say "para = boot-recovery: the next boot starts Gemian (recovery partition). '$PROG --activate' or 'rb-gemini-boot-target retroboot' undoes it." ;;
  previous)
    find_lfs
    cur=$LFS$ROOT_DIR; old=$LFS$ROOT_DIR.old; tmp=$LFS$ROOT_DIR.rollback
    is_running_root "$cur" && die "start Gemian before rolling back"
    is_running_root "$old" && die "start Gemian before rolling back"
    [ -d "$old" ] || die "there is no $ROOT_DIR.old to go back to (use --rollback recovery for Gemian)"
    [ -f "$old$TREE_BOOTIMG" ] || die "$ROOT_DIR.old has no boot.img of its own"
    rm -rf "$tmp"
    mv "$cur" "$tmp" && mv "$old" "$cur" && mv "$tmp" "$old" || die "swapping the trees failed"
    sync
    say "$ROOT_DIR is build $(tree_build "$cur") again; the newer one is $ROOT_DIR.old"
    write_bootimg "$cur$TREE_BOOTIMG"
    reset_counter
    say "para: $(para_state)" ;;
  *) die "--rollback recovery|previous" ;;
  esac
}

ACTIVATE=0; KEEP_DATA=0; MODE=install; RB_MODE=; LINUX_ROOT=
while [ $# -gt 0 ]; do
  case "$1" in
    --activate) ACTIVATE=1 ;;
    --keep-data) KEEP_DATA=1 ;;
    --linux-root) LINUX_ROOT=${2:?}; shift ;;
    --rollback) MODE=rollback; case "${2:-}" in recovery|previous) RB_MODE=$2; shift ;; esac ;;
    --status) MODE=status ;;
    --verify) MODE=verify ;;
    -h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option $1 (--help)" ;;
  esac
  shift
done
[ "$(id -u)" = 0 ] || die "run as root"
need_tools
case "$MODE" in
  install) do_install ;;
  rollback) do_rollback "${RB_MODE:-recovery}" ;;
  status) do_status ;;
  verify) verify_payload ;;
esac
cleanup
exit 0
