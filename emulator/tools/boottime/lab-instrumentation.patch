+/*
+ * RetroBoot: partial TLB flushes by scanning.  @match decides per page
+ * address; the TLB lock is held.  An mmu_idx that holds a large page is
+ * flushed whole, as tlb_flush_page_locked() does.
+ */
+typedef bool (*RBTlbMatch)(vaddr page, const void *opaque);
+
+static bool rb_entry_matches(CPUTLBEntry *e, RBTlbMatch match, const void *opaque)
+{
+    uint64_t a[3] = { e->addr_read, e->addr_write, e->addr_code };
+    int i;
+
+    for (i = 0; i < 3; i++) {
+        if (!(a[i] & TLB_INVALID_MASK) && match(a[i] & TARGET_PAGE_MASK, opaque)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void rb_tlb_flush_scan_locked(CPUState *cpu, RBTlbMatch match,
+                                     const void *opaque)
+{
+    int mmu_idx;
+
+    for (mmu_idx = 0; mmu_idx < NB_MMU_MODES; mmu_idx++) {
+        CPUTLBDesc *d = &cpu->neg.tlb.d[mmu_idx];
+        CPUTLBDescFast *f = &cpu->neg.tlb.f[mmu_idx];
+        size_t n, i, used;
+        int k;
+
+        if (!(cpu->neg.tlb.c.dirty & (1 << mmu_idx))) {
+            continue;
+        }
+        if (d->large_page_addr != -1) {
+            tlb_flush_one_mmuidx_locked(cpu, mmu_idx, get_clock_realtime());
+            continue;
+        }
+        n = tlb_n_entries(f);
+        used = 0;
+        for (i = 0; i < n; i++) {
+            CPUTLBEntry *e = &f->table[i];
+            if (rb_entry_matches(e, match, opaque)) {
+                memset(e, -1, sizeof(*e));
+            } else if (!tlb_entry_is_empty(e)) {
+                used++;
+            }
+        }
+        /* recount: the resize heuristic reads it (victim swaps make it drift) */
+        d->n_used_entries = used;
+        for (k = 0; k < CPU_VTLB_SIZE; k++) {
+            CPUTLBEntry *e = &d->vtable[k];
+            if (rb_entry_matches(e, match, opaque)) {
+                memset(e, -1, sizeof(*e));   /* victim entries are not counted */
+            }
+        }
+    }
+}
+
+/* Jump cache: TBs that start in a matching page or in the page before one. */
+static void rb_jmp_cache_scan(CPUState *cpu, RBTlbMatch match, const void *opaque)
+{
+    CPUJumpCache *jc = cpu->tb_jmp_cache;
+    int i;
+
+    if (unlikely(!jc)) {
+        return;
+    }
+    for (i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+        if (qatomic_read(&jc->array[i].tb)) {
+            vaddr page = jc->array[i].pc & TARGET_PAGE_MASK;
+            if (match(page, opaque) || match(page + TARGET_PAGE_SIZE, opaque)) {
+                qatomic_set(&jc->array[i].tb, NULL);
+            }
+        }
+    }
+}
+
+static bool rb_match_classes(vaddr page, const void *opaque)
+{
+    uint64_t classes = *(const uint64_t *)opaque;
+    return (classes >> ((page >> TARGET_PAGE_BITS) & 63)) & 1;
+}
+
+void tlb_flush_page_classes(CPUState *cpu, uint64_t classes)
+{
+    assert_cpu_is_self(cpu);
+    if (rb_exp() & 8) {
+        classes = UINT64_MAX;       /* lab: scan everything (tests the scan) */
+    } else if (rb_exp() & 16) {
+        tlb_flush(cpu);             /* lab: class path, full flush */
+        return;
+    } else if (classes == UINT64_MAX) {
+        tlb_flush(cpu);
+        return;
+    }
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    if (rb_exp() & 64) {
+        int i;
+        for (i = 0; i < NB_MMU_MODES; i++) {
+            tlb_mmu_flush_locked(&cpu->neg.tlb.d[i], &cpu->neg.tlb.f[i]);
+        }
+    } else {
+        rb_tlb_flush_scan_locked(cpu, rb_match_classes, &classes);
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    if (rb_exp() & 32) {
+        tcg_flush_jmp_cache(cpu);
+    } else {
+        rb_jmp_cache_scan(cpu, rb_match_classes, &classes);
+    }
+}
+
+typedef struct { vaddr lo, hi; } RBRange;
+
+static bool rb_match_range(vaddr page, const void *opaque)
+{
+    const RBRange *r = opaque;
+    return page >= r->lo && page < r->hi;
+}
+
+void tlb_flush_range_scan(CPUState *cpu, vaddr addr, vaddr len)
+{
+    RBRange r = { addr & TARGET_PAGE_MASK, addr + len };
+
+    assert_cpu_is_self(cpu);
+    if (r.hi < r.lo) {
+        r.hi = (vaddr)-1;
+    }
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    rb_tlb_flush_scan_locked(cpu, rb_match_range, &r);
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    rb_jmp_cache_scan(cpu, rb_match_range, &r);
+}
