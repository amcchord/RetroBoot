+/*
+ * RetroBoot boottime lab only (not shipped): guest register sampler.
+ * RB_PCSAMPLE=FILE [RB_PCSAMPLE_US=1000] records, every period of host time,
+ * the vCPU state at its next TB boundary (async_run_on_cpu), also while it
+ * naps, as fixed 192-byte records (RB_PCSAMPLE_PEEK: up to 4 virtual
+ * addresses read per sample; RB_PCSAMPLE_DUMP: one memory dump).
+ */
+typedef struct RBSample {
+    uint64_t rt_ns, vm_ns;
+    uint32_t nip, lr, ctr, msr, srr0, srr1, dec, halted;
+    uint32_t gpr[32];
+    uint32_t peek[4];
+} RBSample;
+
+static uint32_t rb_ps_peek_addr[4];
+static int rb_ps_npeek;
+static uint32_t rb_ps_dump_ptr, rb_ps_dump_len;
+static int64_t rb_ps_dump_at;
+static char *rb_ps_dump_path;
+
+static FILE *rb_ps_file;
+static QEMUTimer *rb_ps_timer;
+static int64_t rb_ps_period_ns;
+static CPUState *rb_ps_cpu;
+static bool rb_ps_pending;
+static unsigned rb_ps_count;
+
+static void rb_ps_sample(CPUState *cs, run_on_cpu_data data)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+    CPUPPCState *env = &cpu->env;
+    RBSample s;
+    int i;
+
+    memset(&s, 0, sizeof(s));
+    s.rt_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    s.vm_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s.nip = env->nip;
+    s.lr = env->lr;
+    s.ctr = env->ctr;
+    s.msr = env->msr;
+    s.srr0 = env->spr[SPR_SRR0];
+    s.srr1 = env->spr[SPR_SRR1];
+    s.dec = cpu_ppc_load_decr(env);
+    s.halted = cs->halted;
+    for (i = 0; i < 32; i++) {
+        s.gpr[i] = env->gpr[i];
+    }
+    for (i = 0; i < rb_ps_npeek; i++) {
+        uint8_t b[4];
+        if (cpu_memory_rw_debug(cs, rb_ps_peek_addr[i], b, 4, false) == 0) {
+            s.peek[i] = ldl_be_p(b);
+        } else {
+            s.peek[i] = 0xdeadbeef;
+        }
+    }
+    if (rb_ps_dump_path && s.rt_ns >= rb_ps_dump_at) {
+        uint8_t b[4];
+        uint32_t base, len;
+        if (cpu_memory_rw_debug(cs, rb_ps_dump_ptr, b, 4, false) == 0) {
+            base = ldl_be_p(b);
+            if (cpu_memory_rw_debug(cs, rb_ps_dump_len, b, 4, false) == 0) {
+                len = ldl_be_p(b);
+                if (len > 0 && len < (16 << 20)) {
+                    uint8_t *buf = g_malloc(len);
+                    if (cpu_memory_rw_debug(cs, base, buf, len, false) == 0) {
+                        FILE *f = fopen(rb_ps_dump_path, "wb");
+                        if (f) {
+                            fwrite(&base, 4, 1, f);
+                            fwrite(buf, len, 1, f);
+                            fclose(f);
+                        }
+                    }
+                    g_free(buf);
+                }
+            }
+        }
+        g_free(rb_ps_dump_path);
+        rb_ps_dump_path = NULL;
+    }
+    fwrite(&s, sizeof(s), 1, rb_ps_file);
+    if ((++rb_ps_count & 255) == 0) {
+        fflush(rb_ps_file);
+    }
+    rb_ps_pending = false;
+}
+
+static void rb_ps_tick(void *opaque)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    if (!rb_ps_pending) {
+        rb_ps_pending = true;
+        async_run_on_cpu(rb_ps_cpu, rb_ps_sample, RUN_ON_CPU_NULL);
+    }
+    timer_mod(rb_ps_timer, now + rb_ps_period_ns);
+}
+
+static void rb_ps_flush(void)
+{
+    if (rb_ps_file) {
+        fflush(rb_ps_file);
+    }
+}
+
+static FILE *rb_st_file;
+static QEMUTimer *rb_st_timer;
+
+static void rb_st_tick(void *opaque)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int i;
+    fprintf(rb_st_file, "%lld", (long long)now);
+    for (i = 0; i < RBS_N; i++) {
+        fprintf(rb_st_file, " %llu", rb_stats[i]);
+    }
+    fputc('\n', rb_st_file);
+    fflush(rb_st_file);
+    timer_mod(rb_st_timer, now + 100 * 1000000LL);
+}
+
+static void rb_ps_init(CPUState *cs)
+{
+    const char *st = getenv("RB_TCGSTATS");
+    if (st && *st && (rb_st_file = fopen(st, "w"))) {
+        rb_st_timer = timer_new_ns(QEMU_CLOCK_REALTIME, rb_st_tick, NULL);
+        timer_mod(rb_st_timer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + 100 * 1000000LL);
+    }
+    const char *path = getenv("RB_PCSAMPLE");
+    const char *us = getenv("RB_PCSAMPLE_US");
+    if (!path || !*path) {
+        return;
+    }
+    rb_ps_file = fopen(path, "wb");
+    if (!rb_ps_file) {
+        error_report("RB_PCSAMPLE: cannot open %s", path);
+        return;
+    }
+    setvbuf(rb_ps_file, NULL, _IOFBF, 1 << 20);
+    atexit(rb_ps_flush);
+    rb_ps_cpu = cs;
+    {
+        const char *pk = getenv("RB_PCSAMPLE_PEEK");
+        const char *dp = getenv("RB_PCSAMPLE_DUMP");
+        while (pk && *pk && rb_ps_npeek < 4) {
+            char *end;
+            rb_ps_peek_addr[rb_ps_npeek++] = strtoul(pk, &end, 16);
+            pk = (*end == ',') ? end + 1 : NULL;
+        }
+        if (dp) {
+            /* PTR_VADDR,LEN_VADDR,AFTER_MS,PATH */
+            char **v = g_strsplit(dp, ",", 4);
+            if (v[0] && v[1] && v[2] && v[3]) {
+                rb_ps_dump_ptr = strtoul(v[0], NULL, 16);
+                rb_ps_dump_len = strtoul(v[1], NULL, 16);
+                rb_ps_dump_at = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + atoll(v[2]) * 1000000LL;
+                rb_ps_dump_path = g_strdup(v[3]);
+            }
+            g_strfreev(v);
+        }
+    }
+    rb_ps_period_ns = (us ? atoll(us) : 1000) * 1000;
+    rb_ps_timer = timer_new_ns(QEMU_CLOCK_REALTIME, rb_ps_tick, NULL);
+    timer_mod(rb_ps_timer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME) + rb_ps_period_ns);
+}
