+/* RetroBoot boottime lab only: TCG event counters (not shipped). */
+#ifndef RB_STATS_H
+#define RB_STATS_H
+enum {
+    RBS_LOOKUP_PTR, RBS_LOOKUP_PTR_FAST, RBS_JC_HIT, RBS_JC_MISS, RBS_HT_MISS,
+    RBS_JC_FLUSH, RBS_TLB_FLUSH, RBS_TLB_FLUSH_PAGE, RBS_TLB_FLUSH_RANGE, RBS_TLB_RANGE_PAGES,
+    RBS_TB_GEN, RBS_EXCP_ALL, RBS_EXCP_DSI, RBS_EXCP_ISI, RBS_EXCP_EXT, RBS_EXCP_PROG,
+    RBS_EXCP_FPU, RBS_EXCP_DEC, RBS_EXCP_SC, RBS_EXCP_OTHER, RBS_JC_MISS_FLAGS, RBS_EXEC_LOOP_TB,
+    RBS_TLBIE, RBS_SR_CHANGE, RBS_FLUSH_SR, RBS_FLUSH_TLBIE, RBS_FLUSH_BOTH, RBS_BAT_CHANGE,
+    RBS_N
+};
+extern unsigned long long rb_stats[32];
+extern int rb_pending_sr, rb_pending_tlbie;
+#define RB_STAT(i) (rb_stats[i]++)
+#define RB_STAT_ADD(i, n) (rb_stats[i] += (n))
+static inline int rb_exp(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("RB_EXP");
+        v = e ? atoi(e) : 0;
+    }
+    return v;
+}
+#endif
