+
 	if (!VInit(refNum)) {
 		printf("Transport layer failure\n");
 		goto openErr;
@@ -138,6 +244,10 @@ int DriverWrite(IOParam *pb) {
 }
 
 int DriverCtl(CntrlParam *pb) {
+	if (pb->csCode == accRun) {
+		checkZoneChange();
+		return noErr;
+	}
 	return controlErr;
 }
 
