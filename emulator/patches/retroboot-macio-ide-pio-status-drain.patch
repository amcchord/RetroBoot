diff --git a/hw/ide/macio.c b/hw/ide/macio.c
index 1a8fa26..fc627a5 100644
--- a/hw/ide/macio.c
+++ b/hw/ide/macio.c
@@ -363,6 +363,27 @@ static void pmac_ide_flush(DBDMA_io *io)
     pmac_ide_drain(io->opaque);
 }
 
+/*
+ * pio-status-drain: firmware that polls Status/Alt Status after a PIO
+ * READ SECTORS (OpenBIOS waits 1 ms per poll while BSY is set) otherwise
+ * pays a full poll interval for every sector burst, because the block
+ * layer completes PIO reads asynchronously.  Finish the in-flight PIO read
+ * before reporting status, as pmac_ide_drain() already does for resets.
+ * Only PIO reads are drained: DMA and ATAPI transfers (Mac OS's own ATA
+ * driver, CD boots) never set pio_aiocb, and PIO writes and cache flushes
+ * stay asynchronous so the BQL is never held across a host write/fsync.
+ */
+static void pmac_ide_pio_status_drain(MACIOIDEState *d)
+{
+    IDEState *s = ide_bus_active_if(&d->bus);
+
+    if (d->pio_status_drain && s->pio_aiocb && s->blk &&
+        s->acct.type == BLOCK_ACCT_READ) {
+        trace_pmac_ide_pio_status_drain(d, s->unit);
+        blk_drain(s->blk);
+    }
+}
+
 /* PowerMac IDE memory IO */
 static uint64_t pmac_ide_read(void *opaque, hwaddr addr, unsigned size)
 {
@@ -370,6 +391,10 @@ static uint64_t pmac_ide_read(void *opaque, hwaddr addr, unsigned size)
     uint64_t retval = 0xffffffff;
     int reg = addr >> 4;
 
+    if (reg == 0x7 || reg == 0x8 || reg == 0x16) {
+        pmac_ide_pio_status_drain(d);
+    }
+
     switch (reg) {
     case 0x0:
         if (size == 1) {
@@ -625,6 +650,8 @@ static const Property macio_ide_properties[] = {
     DEFINE_PROP_UINT64("dma-completion-delay-ns", MACIOIDEState,
                        dma_completion_delay_ns,
                        MACIO_IDE_DEFAULT_COMPLETION_DELAY_NS),
+    DEFINE_PROP_BOOL("pio-status-drain", MACIOIDEState, pio_status_drain,
+                     false),
 };
 
 static void macio_ide_finalizefn(Object *obj)
