diff --git a/include/hw/misc/macio/airport.h b/include/hw/misc/macio/airport.h
new file mode 100644
index 0000000..422d56b
--- /dev/null
+++ b/include/hw/misc/macio/airport.h
@@ -0,0 +1,144 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* RetroBoot AirPort (Hermes-I) card model (opt-in: macio-newworld.airport). */
+#ifndef HW_MISC_MACIO_AIRPORT_H
+#define HW_MISC_MACIO_AIRPORT_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+#include "qemu/timer.h"
+#include "net/net.h"
+#include "chardev/char-fe.h"
+
+#define TYPE_RB_AIRPORT "retroboot-airport"
+OBJECT_DECLARE_SIMPLE_TYPE(RBAirportState, RB_AIRPORT)
+
+#define RB_AIRPORT_MAX_FIDS 32
+#define RB_AIRPORT_INFO_QUEUE 8
+#define RB_AIRPORT_MAX_NETS 16
+#define RB_AIRPORT_TXQ 32
+
+typedef struct APNetwork {
+    uint8_t ssid[32];
+    unsigned ssid_len;
+    uint8_t bssid[6];
+    uint16_t channel;
+    int signal, noise;
+    uint16_t cap;
+} APNetwork;
+
+typedef struct APInfo {
+    uint16_t type;
+    unsigned nbytes;
+    uint8_t data[RB_AIRPORT_MAX_NETS * 50];
+} APInfo;
+
+struct RBAirportState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion regs_mr;
+    MemoryRegion attr_mr;
+    MemoryRegion slot_mr;
+    MemoryRegion klmisc_mr;
+    qemu_irq irq;
+
+    /* properties */
+    NICConf conf;
+    NICState *nic;
+    CharFrontend chr;
+    bool trace;
+    bool trace_data;
+    bool trace_cis;
+    uint32_t trace_limit;
+    bool with_gpio;
+    uint16_t nic_id;
+    uint16_t pri_major, pri_minor;
+    uint16_t initial_sta_major, initial_sta_minor;
+    uint16_t download_major, download_minor;
+
+    /* state */
+    uint8_t mac[6];
+    uint8_t cis[256];
+    unsigned cis_len;
+    bool cis_seen;
+    uint8_t ccr[8];
+    uint32_t slot_ctrl;
+    uint8_t klmisc[0x48];
+    uint16_t regs[0x20];
+    unsigned bap_off[2];
+    bool irq_level;
+    bool aux_enabled;
+    uint32_t aux_addr;
+    int program_mode;
+    uint32_t dl_entry;
+    uint32_t dl_bytes, dl_lo, dl_hi;
+    uint32_t pda_addr, pda_end;
+    bool download_pending;
+    bool sta_running;
+    uint16_t sta_comp, sta_major, sta_minor;
+    uint16_t dl_comp, dl_major, dl_minor;
+    bool port_enabled;
+    bool linked;
+    uint8_t cur_ssid[32];
+    unsigned cur_ssid_len;
+    uint8_t cur_bssid[6];
+    uint16_t cur_channel;
+    int cur_signal, cur_noise;
+    bool ibss;
+    bool lost;
+    uint32_t scan_delay_ms, scan_timeout_ms, assoc_delay_ms;
+    bool scan_pending;
+    QEMUTimer *info_timer, *scan_timer, *assoc_timer;
+
+    /* host bridge */
+    bool bridge_open;
+    bool bridge_away;      /* closed for longer than bridge_grace_ms */
+    uint32_t bridge_grace_ms;
+    uint32_t bridge_opens, bridge_closes;
+    QEMUTimer *grace_timer;  /* QEMU_CLOCK_REALTIME */
+    bool rx_discard;
+    GString *rxline;
+    GString *txq;
+    guint tx_watch;
+    uint32_t seq, scan_seq, join_seq;
+    bool scan_wait;
+    APNetwork nets[RB_AIRPORT_MAX_NETS];
+    int n_nets;
+    uint8_t rx_buf[0x0a00];
+    bool rx_pending;
+    uint32_t tx_frames, rx_frames;
+    QEMUBH *tx_bh;
