+/* UniNorth AGP DMA page table.  Register/PTE semantics are described by
+ * Apple's APSL AppleMacRiscPCI and Linux's uninorth-agp driver.  This
+ * compatibility aperture is opt-in on mac99's populated root bus; only
+ * its selected AGP master's DMA uses it, not ordinary PCI peripherals. */
+static IOMMUTLBEntry unin_agp_translate(IOMMUMemoryRegion *iommu, hwaddr addr,
+                                       IOMMUAccessFlags flag, int iommu_idx)
+{
+    UNINHostState *s = container_of(iommu, UNINHostState, agp_iommu);
+    PCIDevice *bridge = s->agp_bridge;
+    uint32_t base = pci_get_long(bridge->config + 0x8c);
+    uint64_t start = pci_get_long(bridge->config + 0x90) & 0xf0000000;
+    uint64_t length = (base & 0xfff) * 4ULL * 1024 * 1024;
+    uint64_t page = addr & ~0xfffULL;
+    IOMMUTLBEntry entry = {
+        .target_as = &address_space_memory,
+        .iova = page, .translated_addr = page,
+        .addr_mask = 0xfff, .perm = IOMMU_RW,
+    };
+
+    if ((pci_get_long(bridge->config + 0x94) & 0x100) &&
+        addr >= start && addr - start < length) {
+        uint64_t pte_addr = (base & ~0xfffULL) + ((addr - start) >> 12) * 4;
+        uint32_t pte = ldl_le_phys(&address_space_memory, pte_addr);
+
+        if (!(pte & 1)) {
+            entry.perm = IOMMU_NONE;
+        } else {
+            entry.translated_addr = pte & ~0xfffULL;
+        }
+    }
+    return entry;
+}
+
+static AddressSpace *unin_agp_dma_space(PCIBus *bus, void *opaque, int devfn)
+{
+    UNINHostState *s = opaque;
+    return devfn == s->agp_devfn ? &s->agp_dma_as : &address_space_memory;
+}
+
+static const PCIIOMMUOps unin_agp_iommu_ops = {
+    .get_address_space = unin_agp_dma_space,
+};
+
+static void unin_agp_iommu_class_init(ObjectClass *klass, const void *data)
+{
+    IOMMUMemoryRegionClass *imrc = IOMMU_MEMORY_REGION_CLASS(klass);
+    imrc->translate = unin_agp_translate;
+}
+
+static const TypeInfo unin_agp_iommu_info = {
+    .parent = TYPE_IOMMU_MEMORY_REGION,
+    .name = TYPE_UNIN_AGP_IOMMU,
+    .class_init = unin_agp_iommu_class_init,
+};
