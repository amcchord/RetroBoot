 static void pmu_update_extirq(PMUState *s)
 {
-    if ((s->intbits & s->intmask) != 0) {
+    /*
+     * RetroBoot sleep (see "Sleep" below): from PMU_SLEEP until the wake the
+     * processor is powered down and the PMU's interrupt line stays quiet;
+     * what is pending (a one-second tick, an environment or ADB interrupt)
+     * is delivered after the wake.  Mac OS 9.2.2 (Mac OS ROM 8.7) never
+     * recovered from a line held asserted across its sleep: after the wake
+     * its 68K emulator spun in its interrupt dispatch (PC 0x6806e8d0) and the
+     * machine stopped responding.
+     */
+    if ((s->intbits & s->intmask) != 0 && !s->sleeping) {
         macio_set_gpio(s->gpio, 1, false);
     } else {
         macio_set_gpio(s->gpio, 1, true);
