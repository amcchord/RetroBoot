diff --git a/hw/misc/macio/pmu.c b/hw/misc/macio/pmu.c
--- a/hw/misc/macio/pmu.c
+++ b/hw/misc/macio/pmu.c
@@ -220,12 +220,26 @@ static void pmu_cmd_adb(PMUState *s,
         /* Format command */
         adb_cmd[0] = in_data[0];
         memcpy(&adb_cmd[1], &in_data[3], in_len - 3);
-        len = adb_request(&s->adb_bus, s->adb_reply + 2, adb_cmd, in_len - 2);
+        len = adb_request(&s->adb_bus,
+                          s->adb_reply + (s->adb_reply_cmd ? 1 : 2),
+                          adb_cmd, in_len - 2);
 
         trace_pmu_cmd_adb_reply(len);
     }
 
-    if (len > 0) {
+    if (len > 0 && s->adb_reply_cmd) {
+        /*
+         * RetroBoot: the reply is the ADB command byte followed by the
+         * register data, as for autopoll data (pmu_adb_poll).  Mac OS 9's
+         * PMU ADB driver reads the data from the second byte after the
+         * interrupt flags; with the length-prefixed layout below it took
+         * the device's address byte for its handler ID (the ADB mouse
+         * became device type 3 and Apple Monitor Plugins, probing it as an
+         * ADB display, reported "did not load completely", error -29208).
+         */
+        s->adb_reply_size = len + 1;
+        s->adb_reply[0] = in_data[0];
+    } else if (len > 0) {
         /* XXX Check this */
         s->adb_reply_size = len + 2;
         s->adb_reply[0] = 0x01;
@@ -762,6 +776,8 @@ static void pmu_init(Object *obj)
 
 static const Property pmu_properties[] = {
     DEFINE_PROP_BOOL("has-adb", PMUState, has_adb, true),
+    /* RetroBoot: ADB command replies as command byte + data (see pmu_cmd_adb) */
+    DEFINE_PROP_BOOL("adb-reply-cmd", PMUState, adb_reply_cmd, true),
 };
 
 static void pmu_class_init(ObjectClass *oc, const void *data)
diff --git a/include/hw/misc/macio/pmu.h b/include/hw/misc/macio/pmu.h
--- a/include/hw/misc/macio/pmu.h
+++ b/include/hw/misc/macio/pmu.h
@@ -216,6 +216,7 @@ struct PMUState {
 
     /* ADB */
     bool has_adb;
+    bool adb_reply_cmd;         /* RetroBoot: reply = command byte + data */
     ADBBusState adb_bus;
     uint8_t adb_reply_size;
     uint8_t adb_reply[ADB_MAX_OUT_LEN];
