@@ -510,6 +510,13 @@ static void pmu_cmd_int_ack(PMUState *s,
         *out_len = s->adb_reply_size + 1;
         s->intbits &= ~(PMU_INT_ADB | PMU_INT_ADB_AUTO);
         s->adb_reply_size = 0;
+        if (s->adb_cmd_pending) {
+            /* RetroBoot: now the command's own reply (see pmu_cmd_adb) */
+            memcpy(s->adb_reply, s->adb_cmd_reply, s->adb_cmd_reply_size);
+            s->adb_reply_size = s->adb_cmd_reply_size;
+            s->adb_cmd_pending = false;
+            s->intbits |= PMU_INT_ADB;
+        }
     } else {
         out_data[0] = s->intbits;
         s->intbits = 0;
@@ -556,6 +563,16 @@ static void pmu_cmd_adb(PMUState *s,
 {
     int len, adblen;
     uint8_t adb_cmd[255];
+    /*
+     * RetroBoot: autopoll data that has not been acknowledged yet keeps its
+     * buffer and its autopoll flag; the command's reply follows it (INT ACK).
+     * Writing over it lost a key or button event (a release, under a burst)
+     * and handed the guest this reply flagged as autopoll data from the
+     * command's device.
+     */
+    bool behind = s->adb_reply_cmd && (s->intbits & PMU_INT_ADB_AUTO);
+    uint8_t *reply = behind ? s->adb_cmd_reply : s->adb_reply;
+    uint8_t *reply_size = behind ? &s->adb_cmd_reply_size : &s->adb_reply_size;
 
     if (in_len < 2) {
         qemu_log_mask(LOG_GUEST_ERROR,
@@ -606,7 +623,7 @@ static void pmu_cmd_adb(PMUState *s,
         adb_cmd[0] = in_data[0];
         memcpy(&adb_cmd[1], &in_data[3], in_len - 3);
         len = adb_request(&s->adb_bus,
-                          s->adb_reply + (s->adb_reply_cmd ? 1 : 2),
+                          reply + (s->adb_reply_cmd ? 1 : 2),
                           adb_cmd, in_len - 2);
 
         trace_pmu_cmd_adb_reply(len);
@@ -622,19 +639,23 @@ static void pmu_cmd_adb(PMUState *s,
          * became device type 3 and Apple Monitor Plugins, probing it as an
          * ADB display, reported "did not load completely", error -29208).
          */
-        s->adb_reply_size = len + 1;
-        s->adb_reply[0] = in_data[0];
+        *reply_size = len + 1;
+        reply[0] = in_data[0];
     } else if (len > 0) {
         /* XXX Check this */
-        s->adb_reply_size = len + 2;
-        s->adb_reply[0] = 0x01;
-        s->adb_reply[1] = len;
+        *reply_size = len + 2;
+        reply[0] = 0x01;
+        reply[1] = len;
     } else {
         /* XXX Check this */
-        s->adb_reply_size = 1;
-        s->adb_reply[0] = 0x00;
+        *reply_size = 1;
+        reply[0] = 0x00;
     }
 
+    if (behind) {
+        s->adb_cmd_pending = true;
+        return;
+    }
     s->intbits |= PMU_INT_ADB;
     pmu_update_extirq(s);
 }
@@ -1195,6 +1216,26 @@ static bool pmu_adb_state_needed(void *opaque)
     return s->has_adb;
 }
 
+static bool pmu_adb_cmd_reply_needed(void *opaque)
+{
+    PMUState *s = opaque;
+
+    return s->adb_cmd_pending;
+}
+
+static const VMStateDescription vmstate_pmu_adb_cmd_reply = {
+    .name = "pmu/retroboot-adb-cmd-reply",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = pmu_adb_cmd_reply_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(adb_cmd_pending, PMUState),
+        VMSTATE_UINT8(adb_cmd_reply_size, PMUState),
+        VMSTATE_BUFFER(adb_cmd_reply, PMUState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 static const VMStateDescription vmstate_pmu_adb = {
     .name = "pmu/adb",
     .version_id = 1,
@@ -1277,6 +1318,7 @@ static const VMStateDescription vmstate_pmu = {
     },
     .subsections = (const VMStateDescription * const []) {
         &vmstate_pmu_adb,
+        &vmstate_pmu_adb_cmd_reply,
         &vmstate_pmu_battery,
         &vmstate_pmu_backlight,
         NULL
@@ -1298,6 +1340,7 @@ static void pmu_reset(DeviceState *dev)
         s->intmask |= PMU_INT_ENVIRONMENT;
     }
     s->intbits = 0;
+    s->adb_cmd_pending = false;
 
     s->cmd_state = pmu_state_idle;
     if (s->wake_input) {
