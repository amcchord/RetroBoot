diff --git a/hw/input/adb-buttons.c b/hw/input/adb-buttons.c
index 02b1c6d..a7a7e60 100644
--- a/hw/input/adb-buttons.c
+++ b/hw/input/adb-buttons.c
@@ -11,6 +11,10 @@
  * Register 0 reports one button per talk: the button code in the first byte
  * (bit 7 set on release) and 0xff in the second (no second button).
  *
+ * The queue never holds a press without room for its release: a press that
+ * would leave none is dropped together with its release (a burst faster than
+ * Mac OS polls loses whole presses, never a release, so no button stays down).
+ *
  * Copyright (c) 2026 RetroBoot contributors
  * SPDX-License-Identifier: MIT
  */
@@ -41,6 +45,7 @@ struct ADBButtonsState {
     uint8_t handler_prop;
     uint8_t data[ADB_BUTTONS_QUEUE];
     int32_t rptr, wptr, count;
+    uint32_t held;           /* buttons whose press is queued, release not yet */
 };
 
 /* Button codes of the two Apple devices (Mac OS ADBS 0x71F / 0x702). */
@@ -81,7 +86,18 @@ bool adb_buttons_event(DeviceState *dev, ADBButton button, bool down)
         return false;      /* this keyboard has no such button */
     }
     trace_adb_device_buttons_event(buttons[button].name, down, d->devaddr, d->handler);
-    adb_buttons_put(s, down ? code : code | 0x80);
+    if (down) {
+        /* room for this press, its release and every held button's release */
+        if ((s->held & (1u << button)) ||
+            s->count + 2 + ctpop32(s->held) > ADB_BUTTONS_QUEUE) {
+            return true;
+        }
+        s->held |= 1u << button;
+        adb_buttons_put(s, code);
+    } else if (s->held & (1u << button)) {
+        s->held &= ~(1u << button);
+        adb_buttons_put(s, code | 0x80);
+    }
     return true;
 }
 
@@ -103,6 +119,7 @@ static int adb_buttons_request(ADBDevice *d, uint8_t *obuf,
 
     if ((buf[0] & 0x0f) == ADB_FLUSH) {
         s->wptr = s->rptr = s->count = 0;
+        s->held = 0;
         return 0;
     }
     cmd = buf[0] & 0xc;
@@ -185,6 +202,7 @@ static void adb_buttons_reset(DeviceState *dev)
     d->devaddr = ADB_DEVID_MISC;
     d->handler = s->handler_prop;
     s->rptr = s->wptr = s->count = 0;
+    s->held = 0;
 }
 
 static void adb_buttons_realize(DeviceState *dev, Error **errp)
@@ -203,14 +221,15 @@ static void adb_buttons_realize(DeviceState *dev, Error **errp)
 
 static const VMStateDescription vmstate_adb_buttons = {
     .name = "adb_buttons",
-    .version_id = 1,
-    .minimum_version_id = 1,
+    .version_id = 2,
+    .minimum_version_id = 2,
     .fields = (const VMStateField[]) {
         VMSTATE_STRUCT(parent_obj, ADBButtonsState, 0, vmstate_adb_device, ADBDevice),
         VMSTATE_BUFFER(data, ADBButtonsState),
         VMSTATE_INT32(rptr, ADBButtonsState),
         VMSTATE_INT32(wptr, ADBButtonsState),
         VMSTATE_INT32(count, ADBButtonsState),
+        VMSTATE_UINT32(held, ADBButtonsState),
         VMSTATE_END_OF_LIST()
     }
 };
diff --git a/hw/misc/macio/pmu.c b/hw/misc/macio/pmu.c
