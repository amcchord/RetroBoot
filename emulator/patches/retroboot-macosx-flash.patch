+static void pmac_format_core99_flash(MacIONVRAMState *nvr)
+{
+    for (unsigned i = 0; i < 2; i++) {
+        uint8_t *bank = nvr->data + i * CORE99_BANK_SIZE;
+        ChrpNvramPartHdr *header = (ChrpNvramPartHdr *)bank;
+        MacIONVRAMState view = *nvr;
+        unsigned offset;
+
+        /* A 32-byte CHRP partition, followed by ordinary OF partitions. */
+        header->signature = 0x5a;
+        memcpy(header->name, "wwwwwwwwwwww", 12);
+        chrp_nvram_finish_partition(header, 32);
+        stl_be_p(bank + 20, i + 1);
+        view.data = bank + 32;
+        pmac_format_nvram_partition_of(&view, 0, CORE99_BANK_SIZE - 32);
+        for (offset = 32; offset < CORE99_BANK_SIZE;) {
+            ChrpNvramPartHdr *part = (ChrpNvramPartHdr *)(bank + offset);
+            unsigned length = lduw_be_p(&part->len) * 16;
+            if (part->signature == 0x7f) {
+                memcpy(part->name, "wwwwwwwwwwww", 12);
+                chrp_nvram_finish_partition(part, length);
+            }
+            offset += length;
+        }
+        stl_be_p(bank + 16, adler32(1, bank + 20, CORE99_BANK_SIZE - 20));
+    }
+}
