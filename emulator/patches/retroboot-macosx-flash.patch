+static bool macio_nvram_flash_valid(const uint8_t *data)
+{
+    for (unsigned offset = 0; offset < CORE99_FLASH_SIZE;
+         offset += CORE99_BANK_SIZE) {
+        const uint8_t *bank = data + offset;
+        ChrpNvramPartHdr header;
+
+        if (bank[0] != 0x5a || lduw_be_p(bank + 2) != 2) {
+            continue;
+        }
+        memcpy(&header, bank, sizeof(header));
+        chrp_nvram_finish_partition(&header, 32);
+        if (header.checksum == bank[1] &&
+            (uint32_t)ldl_be_p(bank + 16) ==
+            (uint32_t)adler32(1, bank + 20, CORE99_BANK_SIZE - 20)) {
+            return true;
+        }
+    }
+    return false;
+}
