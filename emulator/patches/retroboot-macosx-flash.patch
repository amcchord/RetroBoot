+#define CORE99_BANK_SIZE 8192
+#define CORE99_FLASH_SIZE (2 * CORE99_BANK_SIZE)
+
+/* Core99's public driver uses Intel byte-program/erase/status commands.
+ * Keep this separate from the classic byte-interleaved RAM interface. */
+static bool macio_nvram_persist(MacIONVRAMState *s, uint32_t offset,
+                                uint32_t length)
+{
+    if (s->blk && blk_pwrite(s->blk, offset, length, s->data + offset, 0) < 0) {
+        error_report("%s: write of NVRAM data to backing store failed",
+                     blk_name(s->blk));
+        return false;
+    }
+    return true;
+}
+
+static void macio_nvram_flash_write(MacIONVRAMState *s, uint32_t addr,
+                                     uint8_t value)
+{
+    unsigned bank = addr / CORE99_BANK_SIZE;
+    uint32_t start = bank * CORE99_BANK_SIZE;
+
+    if (s->flash_cmd[bank] == 0x40) {
+        uint8_t old = s->data[addr];
+        s->flash_status[bank] = 0x80;
+        if (addr != s->flash_program_addr[bank]) {
+            s->flash_status[bank] |= 0x30;
+        } else {
+            s->data[addr] &= value;
+            if ((value & ~old) || !macio_nvram_persist(s, addr, 1)) {
+                s->flash_status[bank] |= 0x10;
+            }
+        }
+        s->flash_cmd[bank] = 0x70;
+        return;
+    }
+    if (value == 0xff) {
+        s->flash_cmd[bank] = 0xff;
+        return;
+    }
+    if (s->flash_cmd[bank] == 0x20) {
+        s->flash_status[bank] = 0x80;
+        if (value == 0xd0) {
+            memset(s->data + start, 0xff, CORE99_BANK_SIZE);
+            if (!macio_nvram_persist(s, start, CORE99_BANK_SIZE)) {
+                s->flash_status[bank] |= 0x20;
+            }
+        } else {
+            s->flash_status[bank] |= 0x30;
+        }
+        s->flash_cmd[bank] = 0x70;
+        return;
+    }
+    switch (value) {
+    case 0x40:
+        s->flash_program_addr[bank] = addr;
+        s->flash_cmd[bank] = value;
+        break;
+    case 0x20:
+    case 0x70:
+    case 0x90:
+        s->flash_cmd[bank] = value;
+        break;
+    case 0x50:
+        s->flash_status[bank] = 0x80;
+        s->flash_cmd[bank] = 0x70;
+        break;
+    default:
+        s->flash_status[bank] = 0xb0;
+        s->flash_cmd[bank] = 0x70;
+        break;
+    }
+}
+
+static uint8_t macio_nvram_flash_read(MacIONVRAMState *s, uint32_t addr)
+{
+    unsigned bank = addr / CORE99_BANK_SIZE;
+
+    if (s->flash_cmd[bank] == 0x90) {
+        switch (addr % CORE99_BANK_SIZE) {
+        case 0: return 0x89; /* Intel/Micron top boot flash */
+        case 1: return 0x98;
+        default: return 0;
+        }
+    }
+    if (s->flash_cmd[bank] != 0xff) {
+        return s->flash_status[bank];
+    }
+    return s->data[addr];
+}
