+/* Also advertises relative-message support; an older presenter ignores it. */
+static void rbd_send_pointer_mode(RetroBootDisplay *rbd)
+{
+    if (rbd->fd >= 0) {
+        rbd_send_event(rbd, qemu_input_is_absolute(rbd->dcl.con) ?
+                       "{\"event\":\"pointer-mode\",\"relative\":false}" :
+                       "{\"event\":\"pointer-mode\",\"relative\":true}");
+    }
+}
+
+static void rbd_mouse_mode_changed(Notifier *notify, void *data)
+{
+    RetroBootDisplay *rbd = container_of(notify, RetroBootDisplay,
+                                       mouse_mode_notifier);
+    rbd_send_pointer_mode(rbd);
+}
