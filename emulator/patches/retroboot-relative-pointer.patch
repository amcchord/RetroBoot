+/* Signed deltas have no desktop-edge clamp. USB/ADB devices consume them. */
+static void rbd_pointer_rel(RetroBootDisplay *rbd, int32_t dx, int32_t dy)
+{
+    qemu_input_queue_rel(rbd->dcl.con, INPUT_AXIS_X, CLAMP(dx, -32767, 32767));
+    qemu_input_queue_rel(rbd->dcl.con, INPUT_AXIS_Y, CLAMP(dy, -32767, 32767));
+    qemu_input_event_sync();
+}
