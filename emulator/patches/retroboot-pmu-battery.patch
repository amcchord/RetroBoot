+/*
+ * Sleep (RetroBoot).  A NewWorld PowerBook sleeps with PMU_SLEEP ("MATT"):
+ * Mac OS has saved its state, stored its wake vector at physical 0x80 (and
+ * a parameter at 0x84), and then stops the processor (HID0[SLEEP] with
+ * MSR[POW]); the PMU cuts the power and, on a wake event, powers the
+ * processor up again, whose firmware jumps to the wake vector.  Here the
+ * processor halts, and on a wake event the machine (mac_newworld.c, gpio
+ * "wake") resumes it at the wake vector with translation off, as the
+ * firmware would.  The rest of the machine was never powered down; Mac OS
+ * re-initialises its devices as it does after a real wake.
+ *
+ * Wake events: a key or a pointer button (an input handler that exists only
+ * while asleep; the ADB keyboard is also polled; the press is consumed, as
+ * on a PowerBook) or the host ("wake" over the power bridge,
+ * e.g. the host's power button).  The host is told "sleep" and "wake".
+ * sleep=off keeps QEMU's behaviour (the processor stays halted).
+ */
+#define PMU_RB_SLEEP_POLL_MS    100
+
+/* Runs after the input event that woke the machine has been delivered. */
+static void pmu_wake_input_remove(void *opaque)
+{
+    PMUState *s = opaque;
+
+    if (!s->sleeping && s->wake_input) {
+        qemu_input_handler_unregister(s->wake_input);
+        s->wake_input = NULL;
+    }
+}
+
+static void pmu_wake(PMUState *s, const char *why)
+{
+    char msg[80];
+
+    if (!s->sleeping) {
+        return;
+    }
+    s->sleeping = false;
+    timer_del(s->sleep_poll_timer);
+    if (s->wake_input) {
+        /* not now: this may be the handler's own event callback */
+        aio_bh_schedule_oneshot(qemu_get_aio_context(), pmu_wake_input_remove, s);
+    }
+    pmu_bat_trace(s, "wake (%s)", why);
+    trace_pmu_rb_wake(why);
+    snprintf(msg, sizeof(msg), "{\"type\":\"wake\",\"reason\":\"%s\"}\n", why);
+    pmu_bridge_send(s, msg);
+    qemu_irq_pulse(s->wake_irq);
+}
+
+/*
+ * While asleep a key or a pointer button wakes the machine: this handler
+ * exists only then (registered and put first in line on sleep, removed on
+ * wake, so awake it never sees an event), and it consumes the press that
+ * wakes, as a PowerBook's PMU does.
+ */
+static void pmu_wake_input_event(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    PMUState *s = VIA_PMU(dev);
+
+    if (!s->sleeping) {
+        return;
+    }
+    if ((evt->type == INPUT_EVENT_KIND_KEY && evt->u.key.data->down) ||
+        (evt->type == INPUT_EVENT_KIND_BTN && evt->u.btn.data->down)) {
+        pmu_wake(s, evt->type == INPUT_EVENT_KIND_KEY ? "key" : "button");
+    }
+}
+
+static const QemuInputHandler pmu_wake_input = {
+    .name  = "RetroBoot PMU wake",
+    .mask  = INPUT_EVENT_MASK_KEY | INPUT_EVENT_MASK_BTN,
+    .event = pmu_wake_input_event,
+};
+
+static void pmu_sleep_poll(void *opaque)
+{
+    PMUState *s = opaque;
+    uint8_t buf[ADB_MAX_OUT_LEN];
+
+    if (!s->sleeping) {
+        return;
+    }
+    if (s->has_adb && adb_poll(&s->adb_bus, buf, 0xffff) > 0) {
+        pmu_wake(s, "key");
+        return;
+    }
+    timer_mod(s->sleep_poll_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + PMU_RB_SLEEP_POLL_MS);
+}
+
+static void pmu_cmd_sleep(PMUState *s,
+                          const uint8_t *in_data, uint8_t in_len,
+                          uint8_t *out_data, uint8_t *out_len)
+{
+    char msg[64];
+
+    *out_len = 1;
+    out_data[0] = 0;
+    /*
+     * Mac OS 9.2.1 signs a sleep it was asked for "MATT" and the sleep it
+     * forces when no reserve battery power remains "BORG"; both stop the
+     * processor the same way.
+     */
+    if (in_len != 4 || (memcmp(in_data, "MATT", 4) && memcmp(in_data, "BORG", 4))) {
+        qemu_log_mask(LOG_GUEST_ERROR, "PMU: SLEEP command, unknown signature\n");
+        return;
+    }
+    if (!s->sleep_wake) {
+        return;
+    }
+    s->sleeping = true;
+    s->sleeps++;
+    pmu_bat_trace(s, "guest sleeping (%u, %.4s)", s->sleeps, (const char *)in_data);
+    trace_pmu_rb_sleep(s->sleeps);
+    snprintf(msg, sizeof(msg), "{\"type\":\"sleep\",\"low_battery\":%s}\n",
+             memcmp(in_data, "BORG", 4) ? "false" : "true");
+    pmu_bridge_send(s, msg);
+    if (!s->wake_input) {
+        s->wake_input = qemu_input_handler_register(DEVICE(s), &pmu_wake_input);
+        qemu_input_handler_activate(s->wake_input);
+    }
+    timer_mod(s->sleep_poll_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + PMU_RB_SLEEP_POLL_MS);
+}
