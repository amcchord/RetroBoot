+/*
+ * RetroBoot sleep (hw/misc/macio/pmu.c "Sleep"): resume a sleeping
+ * processor at the wake vector Mac OS stored at physical 0x80, with
+ * translation and interrupts off, as the firmware does after the PMU powers
+ * a PowerBook's processor up again.  The doze/nap/sleep bits are cleared;
+ * Mac OS's wake code restores HID0, the BATs and the rest of its state.
+ */
+#define CORE99_WAKE_VECTOR      0x80
+#define CORE99_HID0_SLEEP       (1 << 21)
+
+static void core99_wake_cpu(CPUState *cs, run_on_cpu_data data)
+{
+    PowerPCCPU *cpu = POWERPC_CPU(cs);
+    CPUPPCState *env = &cpu->env;
+    uint32_t vector = address_space_ldl_be(&address_space_memory,
+                                           CORE99_WAKE_VECTOR,
+                                           MEMTXATTRS_UNSPECIFIED, NULL);
+
+    if (!vector) {
+        error_report("retroboot: wake requested but no wake vector at 0x%x",
+                     CORE99_WAKE_VECTOR);
+        return;
+    }
+    env->spr[SPR_HID0] &= ~(target_ulong)(HID0_DOZE | HID0_NAP |
+                                          CORE99_HID0_SLEEP);
+    ppc_store_msr(env, (target_ulong)1 << MSR_ME);
+    env->nip = vector;
+    tlb_flush(cs);
+    cs->halted = 0;
+}
+
+static void core99_pmu_wake(void *opaque, int n, int level)
+{
+    if (level) {
+        async_safe_run_on_cpu(CPU(opaque), core99_wake_cpu, RUN_ON_CPU_NULL);
+    }
+}
