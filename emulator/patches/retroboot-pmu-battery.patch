+/*
+ * Battery (RetroBoot).  With battery=on the PMU behaves like the PMU99 of a
+ * NewWorld PowerBook with one smart battery, so Mac OS's own Power Manager
+ * (the "via-pmu-99" PowerMgrPlugin in the Mac OS ROM file) drives the Control
+ * Strip Battery Monitor, the menu-bar battery, Energy Saver and the
+ * low-battery warnings with no guest software installed.  The firmware
+ * advertises the battery bay: QEMU publishes fw_cfg etc/retroboot/battery
+ * and OpenBIOS sets the battery count in power-mgt's prim-info (byte 25).
+ *
+ * What Mac OS 9.2.1 uses (research/battery/reports):
+ *  - PMU_SMART_BATTERY_STATE (0x6f) with the battery number (1) returns
+ *    10 bytes: format (5), flags (0x01 external power, 0x04 battery present),
+ *    charge, full charge, current (signed; negative while discharging) and
+ *    voltage, each 16 bits big-endian.  Mac OS derives "charging" from
+ *    external power with a positive current, and the time remaining from
+ *    charge * 3600 / -current seconds.
+ *  - PMU_GET_COVER (0xdc) bit 0x04: the power adapter is connected.  Bit
+ *    0x01 (lid closed) is never reported: the host owns the lid.
+ *  - An environment interrupt (0x40, followed by the same environment byte)
+ *    makes Mac OS read the power sources again.  Mac OS never sets the
+ *    interrupt mask on this machine, so it is part of the reset mask.
+ *
+ * The state comes from the host (RetroBoot hostd) over a chardev bridge:
+ * newline-delimited JSON, normally a reconnecting client socket to
+ * /run/retroboot/power.sock (docs/ARCHITECTURE.md "Power bridge").  Until the
+ * host reports, the battery is absent and the adapter connected; the last
+ * report is kept while the host is away.  The handlers run in QEMU's main
+ * loop with the BQL held.
+ */
+#define PMU_RB_BRIDGE_VERSION   1
+#define PMU_RB_RX_LINE_MAX      4096
+#define PMU_RB_CAPACITY_MAH     4400    /* reported full charge */
+#define PMU_RB_VOLTAGE_MV       11400   /* when the host has no reading */
+#define PMU_RB_CURRENT_MAX_MA   12000
+
+#define PMU_SB_FLAG_EXTERNAL    0x01
+#define PMU_SB_FLAG_PRESENT     0x04
+#define PMU_ENV_ADAPTER         0x04
+
+static void G_GNUC_PRINTF(2, 3) pmu_bat_trace(PMUState *s, const char *fmt, ...)
+{
+    va_list ap;
+    g_autofree char *msg = NULL;
+
+    if (!s->battery_trace) {
+        return;
+    }
+    va_start(ap, fmt);
+    msg = g_strdup_vprintf(fmt, ap);
+    va_end(ap);
+    info_report("retroboot-pmu: %s", msg);
+}
+
+static uint8_t pmu_battery_env(PMUState *s)
+{
+    return s->bat_ac ? PMU_ENV_ADAPTER : 0;
+}
+
+static uint8_t pmu_battery_flags(PMUState *s)
+{
+    return (s->bat_ac ? PMU_SB_FLAG_EXTERNAL : 0) |
+           (s->bat_present ? PMU_SB_FLAG_PRESENT : 0);
+}
+
+static void pmu_battery_defaults(PMUState *s)
+{
+    s->bat_present = false;
+    s->bat_ac = true;
+    s->bat_charging = false;
+    s->bat_charge = 0;
+    s->bat_max = PMU_RB_CAPACITY_MAH;
+    s->bat_current = 0;
+    s->bat_voltage = PMU_RB_VOLTAGE_MV;
+}
+
+static int64_t qdict_num(QDict *d, const char *key, int64_t dflt)
+{
+    QNum *n = qobject_to(QNum, qdict_get(d, key));
+    double v;
+    int64_t i;
+
+    if (!n) {
+        return dflt;
+    }
+    if (qnum_get_try_int(n, &i)) {
+        return i;
+    }
+    v = qnum_get_double(n);
+    return (int64_t)(v + (v < 0 ? -0.5 : 0.5));
+}
+
+static bool qdict_flag(QDict *d, const char *key, bool dflt)
+{
+    QBool *b = qobject_to(QBool, qdict_get(d, key));
+
+    return b ? qbool_get_bool(b) : dflt;
+}
+
+/*
+ * {"type":"battery","present":bool,"ac":bool,"charging":bool,"percent":n,
+ *  "time_to_empty_min":n|null,"time_to_full_min":n|null,"voltage_mv":n|null}
+ * becomes the smart battery's registers.  The current is chosen so that Mac
+ * OS's own time estimate (charge / current) matches the host's.
+ */
+static void pmu_battery_report(PMUState *s, QDict *d)
+{
+    bool present = qdict_flag(d, "present", false);
+    bool ac = qdict_flag(d, "ac", true);
+    bool charging = ac && present && qdict_flag(d, "charging", false);
+    int64_t pct = qdict_num(d, "percent", -1);
+    int64_t tte = qdict_num(d, "time_to_empty_min", -1);
+    int64_t ttf = qdict_num(d, "time_to_full_min", -1);
+    int64_t mv = qdict_num(d, "voltage_mv", -1);
+    uint16_t max = PMU_RB_CAPACITY_MAH, charge = 0, voltage = PMU_RB_VOLTAGE_MV;
+    int64_t current = 0;
+    bool changed;
+
+    if (pct < 0 || pct > 100) {
+        present = false;
+        charging = false;
+    }
+    if (present) {
+        charge = (uint16_t)((pct * max + 50) / 100);
+        if (mv >= 6000 && mv <= 20000) {
+            voltage = mv;
+        }
+        if (!ac) {
+            /* discharging: unknown time -> a modest 10 W draw */
+            current = tte > 0 ? -(int64_t)charge * 60 / tte : -(10000000 / voltage);
+            current = MIN(current, -1);
+        } else if (charging) {
+            current = ttf > 0 ? (int64_t)(max - charge) * 60 / ttf : max / 2;
+            current = MAX(current, 1);
+        }
+        current = MAX(MIN(current, PMU_RB_CURRENT_MAX_MA), -PMU_RB_CURRENT_MAX_MA);
+    }
+
+    changed = present != s->bat_present || ac != s->bat_ac ||
+              charging != s->bat_charging || charge != s->bat_charge ||
+              current != s->bat_current;
+    s->bat_present = present;
+    s->bat_ac = ac;
+    s->bat_charging = charging;
+    s->bat_charge = charge;
+    s->bat_max = max;
+    s->bat_current = current;
+    s->bat_voltage = voltage;
+    s->bat_updates++;
+    pmu_bat_trace(s, "host battery: present=%d ac=%d charging=%d %u/%u mAh "
+                  "%d mA %u mV%s", present, ac, charging, charge, max,
+                  (int)current, voltage, changed ? " (changed)" : "");
+    if (changed) {
+        /* Mac OS reads the power sources again on an environment interrupt */
+        s->intbits |= PMU_INT_ENVIRONMENT;
+        s->env_interrupts++;
+        pmu_update_extirq(s);
+    }
+}
+
+static void pmu_bridge_send(PMUState *s, const char *line)
+{
+    if (!s->bridge_open) {
+        return;
+    }
+    /* best effort: one short line; a full socket drops it */
+    qemu_chr_fe_write(&s->chr, (const uint8_t *)line, strlen(line));
+}
+
+static void pmu_wake(PMUState *s, const char *why);
+
+static void pmu_bridge_message(PMUState *s, const char *line)
+{
+    Error *err = NULL;
+    QObject *obj = qobject_from_json(line, &err);
+    QDict *d = qobject_to(QDict, obj);
+    const char *type;
+
+    if (!d) {
+        pmu_bat_trace(s, "bridge: malformed message ignored");
+        error_free(err);
+        qobject_unref(obj);
+        return;
+    }
+    type = qdict_get_try_str(d, "type");
+    if (type && !strcmp(type, "battery")) {
+        pmu_battery_report(s, d);
+    } else if (type && !strcmp(type, "wake")) {
+        pmu_wake(s, "host");
+    } else if (type && !strcmp(type, "hello")) {
+        pmu_bat_trace(s, "bridge: host hello version %" PRId64,
+                      qdict_get_try_int(d, "version", 0));
+    }
+    qobject_unref(obj);
+}
+
+static int pmu_bridge_can_read(void *opaque)
+{
+    return 4096;
+}
+
+static void pmu_bridge_read(void *opaque, const uint8_t *buf, int size)
+{
+    PMUState *s = opaque;
+
+    for (int i = 0; i < size; i++) {
+        if (buf[i] != '\n') {
+            if (s->rx_discard) {
+                continue;
+            }
+            if (s->rxline->len >= PMU_RB_RX_LINE_MAX) {
+                pmu_bat_trace(s, "bridge: oversized message discarded");
+                s->rx_discard = true;
+                g_string_truncate(s->rxline, 0);
+                continue;
+            }
+            g_string_append_c(s->rxline, buf[i]);
+            continue;
+        }
+        if (!s->rx_discard && s->rxline->len) {
+            pmu_bridge_message(s, s->rxline->str);
+        }
+        s->rx_discard = false;
+        g_string_truncate(s->rxline, 0);
+    }
+}
+
+static void pmu_bridge_event(void *opaque, QEMUChrEvent event)
+{
+    PMUState *s = opaque;
+    char hello[128];
+
+    switch (event) {
+    case CHR_EVENT_OPENED:
+        s->bridge_open = true;
+        s->bridge_opens++;
+        g_string_truncate(s->rxline, 0);
+        s->rx_discard = false;
+        pmu_bat_trace(s, "bridge connected (connection %u)", s->bridge_opens);
+        snprintf(hello, sizeof(hello),
+                 "{\"type\":\"hello\",\"version\":%d,\"battery\":%s,"
+                 "\"sleeping\":%s}\n", PMU_RB_BRIDGE_VERSION,
+                 s->battery ? "true" : "false", s->sleeping ? "true" : "false");
+        pmu_bridge_send(s, hello);
+        break;
+    case CHR_EVENT_CLOSED:
+        /* nothing here may write: CLOSED can come from inside a write */
+        if (s->bridge_open) {
+            pmu_bat_trace(s, "bridge disconnected; last battery state kept");
+        }
+        s->bridge_open = false;
+        g_string_truncate(s->rxline, 0);
+        s->rx_discard = false;
+        break;
+    default:
+        break;
+    }
+}
+
+static void pmu_cmd_smart_battery(PMUState *s,
+                                  const uint8_t *in_data, uint8_t in_len,
+                                  uint8_t *out_data, uint8_t *out_len)
+{
+    bool ours = in_len >= 1 && in_data[0] == 1;
+    uint8_t flags = s->bat_ac ? PMU_SB_FLAG_EXTERNAL : 0;
+
+    if (!s->battery) {
+        /* as before: no reply (Mac OS asks only when prim-info has a bay) */
+        *out_len = 0;
+        return;
+    }
+    if (ours) {
+        flags = pmu_battery_flags(s);
+    }
+    out_data[0] = 5;            /* format: 16-bit fields */
+    out_data[1] = flags;
+    memset(out_data + 2, 0, 8);
+    if (ours && s->bat_present) {
+        stw_be_p(out_data + 2, s->bat_charge);
+        stw_be_p(out_data + 4, s->bat_max);
+        stw_be_p(out_data + 6, (uint16_t)s->bat_current);
+        stw_be_p(out_data + 8, s->bat_voltage);
+    }
+    *out_len = 10;
+    trace_pmu_cmd_smart_battery(in_len ? in_data[0] : 0, flags,
+                                ours ? s->bat_charge : 0,
+                                ours ? s->bat_current : 0);
+}
