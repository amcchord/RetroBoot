+/*
+ * Backlight (RetroBoot, -global via-pmu.backlight=on): a PowerBook's display
+ * backlight.  The machine then publishes etc/retroboot/backlight and OpenBIOS
+ * adds the "backlight" node (backlight-control "pmu"), so Mac OS loads its
+ * backlight driver, and sets private power-management feature 0x200, so Mac
+ * OS's PowerBook button driver (ADB address 7, handler 0x1f; see
+ * hw/input/adb-buttons.c) hands the brightness, volume, mute and eject keys
+ * to its Button Manager.  The driver sets the level with PMU_BACKLIGHT_BRIGHT
+ * (lower is brighter) and switches the lamp with PMU_POWER_CTRL.  The host
+ * owns the real panel: each change goes over the power bridge
+ * ({"type":"backlight","level":N,"on":B}) and hostd sets the host backlight.
+ * Without the property both commands keep their old behaviour (no reply).
+ */
+static void pmu_backlight_report(PMUState *s, const char *why)
+{
+    char msg[128];
+
+    if (!s->backlight) {
+        return;
+    }
+    if (s->backlight_have_level) {
+        snprintf(msg, sizeof(msg),
+                 "{\"type\":\"backlight\",\"level\":%u,\"on\":%s,\"why\":\"%s\"}\n",
+                 s->backlight_level, s->backlight_on ? "true" : "false", why);
+    } else {
+        snprintf(msg, sizeof(msg),
+                 "{\"type\":\"backlight\",\"level\":null,\"on\":%s,\"why\":\"%s\"}\n",
+                 s->backlight_on ? "true" : "false", why);
+    }
+    pmu_bridge_send(s, msg);
+}
+
+static void pmu_cmd_backlight_bright(PMUState *s,
+                                     const uint8_t *in_data, uint8_t in_len,
+                                     uint8_t *out_data, uint8_t *out_len)
+{
+    *out_len = 0;
+    trace_pmu_rb_backlight("bright", in_len, in_len ? in_data[0] : 0);
+    if (!s->backlight || in_len < 1) {
+        return;
+    }
+    s->backlight_level = in_data[0];
+    s->backlight_have_level = true;
+    s->backlight_cmds++;
+    pmu_backlight_report(s, "level");
+}
+
+static void pmu_cmd_power_ctrl(PMUState *s,
+                               const uint8_t *in_data, uint8_t in_len,
+                               uint8_t *out_data, uint8_t *out_len)
+{
+    *out_len = 0;
+    trace_pmu_rb_backlight("power", in_len, in_len ? in_data[0] : 0);
+    if (!s->backlight || in_len < 1 || !(in_data[0] & PMU_POW_BACKLIGHT)) {
+        return;
+    }
+    s->backlight_on = !!(in_data[0] & PMU_POW_ON);
+    s->backlight_cmds++;
+    pmu_backlight_report(s, "power");
+}
+
 static void pmu_cmd_int_ack(PMUState *s,
                             const uint8_t *in_data, uint8_t in_len,
                             uint8_t *out_data, uint8_t *out_len)
@@ -908,6 +974,8 @@ static const PMUCmdHandler PMUCmdHandlers[] = {
     { PMU_READ_PMU_RAM, "READ PMGR RAM", pmu_cmd_read_pmu_ram },
     { PMU_SMART_BATTERY_STATE, "SMART BATTERY", pmu_cmd_smart_battery },
     { PMU_SLEEP, "SLEEP", pmu_cmd_sleep },
+    { PMU_BACKLIGHT_BRIGHT, "BACKLIGHT BRIGHT", pmu_cmd_backlight_bright },
+    { PMU_POWER_CTRL, "POWER CTRL", pmu_cmd_power_ctrl },
 };
 
