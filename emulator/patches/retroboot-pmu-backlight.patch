+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = pmu_backlight_state_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT8(backlight_level, PMUState),
+        VMSTATE_BOOL(backlight_have_level, PMUState),
+        VMSTATE_BOOL(backlight_on, PMUState),
+        VMSTATE_UINT32(backlight_cmds, PMUState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 static const VMStateDescription vmstate_pmu = {
     .name = "pmu",
     .version_id = 1,
@@ -1178,6 +1267,7 @@ static const VMStateDescription vmstate_pmu = {
     .subsections = (const VMStateDescription * const []) {
         &vmstate_pmu_adb,
         &vmstate_pmu_battery,
+        &vmstate_pmu_backlight,
         NULL
     }
 };
@@ -1188,6 +1278,10 @@ static void pmu_reset(DeviceState *dev)
 
     /* OpenBIOS needs to do this? MacOS 9 needs it */
     s->intmask = PMU_INT_ADB | PMU_INT_TICK;
+    /* The lamp is on at power-up; Mac OS sets a level when it changes it */
+    s->backlight_on = true;
+    s->backlight_have_level = false;
+    s->backlight_cmds = 0;
     if (s->battery) {
         /* Mac OS never sets the mask: power source changes must get through */
         s->intmask |= PMU_INT_ENVIRONMENT;
@@ -1274,6 +1368,7 @@ static const Property pmu_properties[] = {
     DEFINE_PROP_BOOL("battery-trace", PMUState, battery_trace, false),
     DEFINE_PROP_CHR("chardev", PMUState, chr),
     DEFINE_PROP_BOOL("sleep", PMUState, sleep_wake, true),
+    DEFINE_PROP_BOOL("backlight", PMUState, backlight, false),
 };
 
