+/*
+ * RetroBoot (t2_hold): should a timer-2 interrupt that is due now wait?
+ *
+ * At startup the Macintosh ROM (the Quadra's, and the 68k code of the Power
+ * Macintosh ROMs) times its delay loops against timer 2: it loads about
+ * 1 ms, enables the interrupt and counts a DBRA loop of at most 65536
+ * iterations; the level-1 handler discards its frame and jumps to the code
+ * after the loop, which stores the count and moves a table pointer on to
+ * the next loop, whose first instructions load timer 2 again.  An interrupt
+ * that arrives in the dozen instructions between the pointer's advance and
+ * that load makes the handler run the store a second time with the pointer
+ * already advanced: the ROM writes a count into low memory (exception
+ * vectors) and later runs wild.  On hardware those instructions take about
+ * a microsecond.  Under TCG they run for the first time when a loop runs
+ * out and are translated block by block, and guest time follows the host
+ * clock, so a deadline a little after the end of a loop can land among
+ * them; more often on a busy or slow host.
+ *
+ * So, while timer 2's interrupt is enabled, an interrupt that falls due
+ * while the vCPU is translating waits until the vCPU has not translated for
+ * t2_hold_quiet_us (hot code: a timing loop), at most t2_hold_max_us.  A
+ * loop that is still running takes its interrupt as before; one that has
+ * run out reaches the next load of timer 2, which cancels the interrupt as
+ * on hardware.  The counter keeps host time.  (The PowerPC package's
+ * retroboot-via-t2-hold.patch, for mos6522-cuda/pmu.)
+ */
+static bool mos6522_t2_hold(MOS6522State *s, int64_t now)
+{
+    int64_t quiet;
+
+    if (!s->t2_hold || !(s->ier & T2_INT)) {
+        return false;
+    }
+    if (!s->t2_held_since) {
+        s->t2_held_since = now;
+    }
+    if (now - s->t2_held_since >= (int64_t)s->t2_hold_max_us * SCALE_US) {
+        return false;
+    }
+    quiet = cpu_translation_quiet_ns(now);
+    if (quiet >= (int64_t)s->t2_hold_quiet_us * SCALE_US) {
+        return false;
+    }
+    /* look again when the vCPU could have been quiet long enough */
+    timer_mod(s->timers[1].timer,
+              now + (int64_t)s->t2_hold_quiet_us * SCALE_US - quiet);
+    return true;
+}
+
 static void mos6522_timer2(void *opaque)
 {
     MOS6522State *s = opaque;
     MOS6522Timer *ti = &s->timers[1];
 
+    if (mos6522_t2_hold(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL))) {
+        return;
+    }
+    s->t2_held_since = 0;
     mos6522_timer2_update(s, ti, ti->next_irq_time);
     s->ifr |= T2_INT;
     mos6522_update_irq(s);
@@ -304,7 +365,8 @@ uint64_t mos6522_read(void *opaque, hwaddr addr, unsigned size)
         mos6522_timer1_update(s, &s->timers[0], now);
         s->ifr |= T1_INT;
     }
-    if (now >= s->timers[1].next_irq_time) {
+    if (now >= s->timers[1].next_irq_time && !mos6522_t2_hold(s, now)) {
+        s->t2_held_since = 0;
         mos6522_timer2_update(s, &s->timers[1], now);
         s->ifr |= T2_INT;
     }
@@ -664,6 +726,7 @@ static void mos6522_reset_hold(Object *obj, ResetType type)
 
     s->timers[1].frequency = s->frequency;
     s->timers[1].latch = 0xffff;
+    s->t2_held_since = 0;
     timer_del(s->timers[1].timer);
 }
 
