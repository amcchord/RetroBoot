diff --git a/qapi/ui.json b/qapi/ui.json
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1543,10 +1543,15 @@
 #     QEMU connects as a client and retries every 100 ms until the
 #     presenter listens, without blocking the guest.
 #
+# @idle-refresh: Refresh interval in milliseconds once the guest has
+#     drawn nothing and the presenter has sent no input for one second
+#     (default 100).  Any drawing or input restores the presenter's
+#     rate.  0 always refreshes at the presenter's rate.
+#
 # Since: 11.0
 ##
 { 'struct'  : 'DisplayRetroBoot',
-  'data'    : { 'socket' : 'str' },
+  'data'    : { 'socket' : 'str', '*idle-refresh' : 'uint32' },
   'if'      : 'CONFIG_RETROBOOT_DISPLAY' }
 
 ##
diff --git a/ui/retroboot.c b/ui/retroboot.c
--- a/ui/retroboot.c
+++ b/ui/retroboot.c
@@ -41,6 +41,8 @@
 #define RBD_REFRESH_DISCONNECTED_MS 500
 #define RBD_REFRESH_MIN_MS          4
 #define RBD_REFRESH_MAX_MS          1000
+#define RBD_REFRESH_IDLE_MS         100     /* default idle-refresh */
+#define RBD_IDLE_AFTER_MS           1000
 #define RBD_RECV_BUFFER             512
 #define RBD_RECV_BUDGET             256
 #define RBD_RESIZE_MIN              64
@@ -148,6 +150,12 @@ typedef struct RetroBootDisplay {
     uint64_t connections;
     uint64_t damage_sent;
     uint64_t damage_dropped;
+
+    /* Idle refresh: nothing drawn and no input for RBD_IDLE_AFTER_MS */
+    uint32_t idle_refresh_ms;   /* 0: off */
+    bool drew;                  /* this refresh sent SURFACE or DAMAGE */
+    bool idle;
+    int64_t active_ms;          /* last drawing or input */
 } RetroBootDisplay;
 
 static void rbd_disconnect(RetroBootDisplay *rbd, const char *reason);
@@ -270,9 +278,27 @@ static void rbd_check_clock(RetroBootDisplay *rbd)
 
 static void rbd_set_interval(RetroBootDisplay *rbd)
 {
+    uint32_t ms = rbd->interval_ms;
+
+    if (rbd->idle) {
+        ms = MAX(ms, rbd->idle_refresh_ms);
+    }
     update_displaychangelistener(&rbd->dcl,
-                                 rbd->fd >= 0 ? rbd->interval_ms
-                                              : RBD_REFRESH_DISCONNECTED_MS);
+                                 rbd->fd >= 0 ? ms : RBD_REFRESH_DISCONNECTED_MS);
+}
+
+/*
+ * Drawing or presenter input: back to the presenter's rate.  Lowering the
+ * interval re-arms the console timer from the last refresh, so the first
+ * frame after input is not delayed by the idle interval.
+ */
+static void rbd_active(RetroBootDisplay *rbd)
+{
+    rbd->active_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    if (rbd->idle) {
+        rbd->idle = false;
+        rbd_set_interval(rbd);
+    }
 }
 
 /* Shared buffer ---------------------------------------------------------- */
@@ -407,6 +433,7 @@ static void rbd_flush(RetroBootDisplay *rbd)
             rbd->surface_pending = false;
             rbd->full_damage_pending = false;
         }
+        rbd->drew = true;
         return;
     }
 
@@ -439,6 +466,7 @@ static void rbd_flush(RetroBootDisplay *rbd)
         return;
     }
 
+    rbd->drew = true;
     if (ret > 0) {
         rbd->full_damage_pending = false;
         rbd->damage_sent++;
@@ -638,6 +666,9 @@ static void rbd_handle_message(RetroBootDisplay *rbd, const uint8_t *buf,
         break;
     }
 
+    if (hdr.type != RBD_MSG_REFRESH_RATE) {
+        rbd_active(rbd);
+    }
     switch (hdr.type) {
     case RBD_MSG_KEY:
         rbd_key(rbd, pair.a, pair.b != 0);
@@ -800,7 +831,17 @@ static void rbd_refresh(DisplayChangeListener *dcl)
 
     graphic_hw_update(dcl->con);
     rbd_check_clock(rbd);
+    rbd->drew = false;
     rbd_flush(rbd);
+    if (rbd->drew || rbd->fd < 0) {
+        rbd_active(rbd);
+    } else if (!rbd->idle && rbd->idle_refresh_ms > rbd->interval_ms &&
+               qemu_clock_get_ms(QEMU_CLOCK_REALTIME) - rbd->active_ms >=
+               RBD_IDLE_AFTER_MS) {
+        /* an idle guest: scan the framebuffer less often */
+        rbd->idle = true;
+        rbd_set_interval(rbd);
+    }
 }
 
 static void rbd_gfx_update(DisplayChangeListener *dcl,
@@ -880,6 +921,10 @@ static void rbd_display_init(DisplayState *ds, DisplayOptions *opts)
     rbd->socket_path = g_strdup(path);
     rbd->interval_ms = RBD_REFRESH_CONNECTED_MS;
     rbd->start_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    rbd->active_ms = rbd->start_ms;
+    rbd->idle_refresh_ms = opts->u.retroboot.has_idle_refresh ?
+        MIN(opts->u.retroboot.idle_refresh, RBD_REFRESH_MAX_MS) :
+        RBD_REFRESH_IDLE_MS;
     pixman_region32_init(&rbd->damage);
 #ifdef CONFIG_TCG
     rbd->icount_at_start = icount_enabled();
