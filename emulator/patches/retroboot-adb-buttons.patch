diff --git a/include/hw/input/adb-buttons.h b/include/hw/input/adb-buttons.h
new file mode 100644
index 0000000..80ea935
--- /dev/null
+++ b/include/hw/input/adb-buttons.h
@@ -0,0 +1,27 @@
+/*
+ * ADB special-function buttons (RetroBoot)
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef HW_INPUT_ADB_BUTTONS_H
+#define HW_INPUT_ADB_BUTTONS_H
+
+#define TYPE_ADB_BUTTONS "adb-buttons"
+
+#define ADB_BUTTONS_HANDLER_ADJUSTABLE 0x02   /* AppleDesign Keyboard */
+#define ADB_BUTTONS_HANDLER_POWERBOOK  0x1f   /* PowerBook keyboard */
+
+typedef enum ADBButton {
+    ADB_BUTTON_VOLUME_UP,
+    ADB_BUTTON_VOLUME_DOWN,
+    ADB_BUTTON_MUTE,
+    ADB_BUTTON_BRIGHTNESS_UP,
+    ADB_BUTTON_BRIGHTNESS_DOWN,
+    ADB_BUTTON_EJECT,
+} ADBButton;
+
+/* Queue one press or release; false if this keyboard has no such button. */
+bool adb_buttons_event(DeviceState *dev, ADBButton button, bool down);
+/* "volume-up" ... "eject" to an ADBButton, or -1. */
+int adb_buttons_lookup(const char *name);
+
+#endif
